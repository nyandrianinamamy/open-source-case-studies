    __retres = 0;
    goto return_label;
  }
  gettimeofday(& start,(void *)0);
  thread_per_matrix_main(A,B);
  gettimeofday(& stop,(void *)0);
  printf("Per matrix: Microseconds taken: %lu\n",
         (unsigned long)(stop.tv_usec - start.tv_usec)); /* printf_va_8 */
  gettimeofday(& start,(void *)0);
  thread_per_row_main(A,B);
  gettimeofday(& stop,(void *)0);
  printf("Per row: Microseconds taken: %lu\n",
         (unsigned long)(stop.tv_usec - start.tv_usec)); /* printf_va_9 */
  gettimeofday(& start,(void *)0);
  thread_per_element_main(A,B);
  gettimeofday(& stop,(void *)0);
  printf("Per element: Microseconds taken: %lu\n",
         (unsigned long)(stop.tv_usec - start.tv_usec)); /* printf_va_10 */
  {
    int i_1 = 0;
    while (i_1 < A->rows) {
      free((void *)*(A->arr + i_1));
      i_1 ++;
    }
  }
  free((void *)A->arr);
  free((void *)A);
  {
    int i_2 = 0;
    while (i_2 < B->rows) {
      free((void *)*(B->arr + i_2));
      i_2 ++;
    }
  }
  free((void *)B->arr);
  free((void *)B);
  __retres = 0;
  return_label: return __retres;
}



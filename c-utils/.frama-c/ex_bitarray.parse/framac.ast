    goto return_label;
  }
  if (((int)*(ba->arr + bit / (size_t)8) & (1 << bit % (unsigned long)8)) != 0) 
    tmp = 1;
  else tmp = 0;
  int was_previously_set = tmp;
  *(ba->arr + bit / (size_t)8) = (unsigned char)((int)*(ba->arr + bit / (size_t)8) | (
                                                 1 << bit % (unsigned long)8));
  __retres = was_previously_set;
  return_label: return __retres;
}

int ba_toggle_bit(bitarray_t ba, size_t bit)
{
  int __retres;
  int tmp;
  if (bit >= ba->num_bits) {
    __retres = -1;
    goto return_label;
  }
  *(ba->arr + bit / (size_t)8) = (unsigned char)((int)*(ba->arr + bit / (size_t)8) ^ (
                                                 1 << bit % (unsigned long)8));
  tmp = ba_check_bit(ba,bit);
  __retres = tmp;
  return_label: return __retres;
}

int ba_clear_bit(bitarray_t ba, size_t bit)
{
  int __retres;
  if (bit >= ba->num_bits) {
    __retres = -1;
    goto return_label;
  }
  *(ba->arr + bit / (size_t)8) = (unsigned char)((int)*(ba->arr + bit / (size_t)8) & ~ (
                                                 1 << bit % (unsigned long)8));
  __retres = 0;
  return_label: return __retres;
}

int ba_reset(bitarray_t ba)
{
  int __retres;
  memset((void *)ba->arr,0,ba->num_chars);
  __retres = 0;
  return __retres;
}

char *ba_to_string(bitarray_t ba)
{
  size_t i;
  char *res = calloc(ba->num_bits + (size_t)1,sizeof(char));
  i = (size_t)0;
  while (i < ba->num_bits) {
    if (((int)*(ba->arr + i / (size_t)8) & (1 << i % (unsigned long)8)) != 0) 
      *(res + i) = (char)'1';
    else *(res + i) = (char)'0';
    i ++;
  }
  return res;
}

size_t ba_number_bits_set(bitarray_t ba)
{
  size_t i;
  size_t res = (size_t)0;
  i = (size_t)0;
  while (i < ba->num_chars) {
    res += (size_t)bits_set_table[*(ba->arr + i)];
    i ++;
  }
  return res;
}



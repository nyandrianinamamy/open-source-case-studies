     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255};
  uint8_t visited_data[5 * 5] = {(uint8_t)0};
  uint8_t expected_visisted_data[5 * 5] =
    {(uint8_t)0,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0};
  struct gs_image img =
    {.w = (unsigned int)5, .h = (unsigned int)5, .data = data};
  struct gs_image visited =
    {.w = (unsigned int)5, .h = (unsigned int)5, .data = visited_data};
  struct gs_point __constr_expr_14 =
    {.x = (unsigned int)1, .y = (unsigned int)0};
  contour.start = __constr_expr_14;
  gs_trace_contour(img,visited,& contour);
  __FC_assert((contour.length == (unsigned int)10) != 0,"test.c",282,
              "contour.length == 10");
  if (contour.box.x == (unsigned int)1) 
    if (contour.box.y == (unsigned int)0) 
      if (contour.box.w == (unsigned int)4) 
        if (contour.box.h == (unsigned int)5) tmp = 1; else tmp = 0;
      else tmp = 0;
    else tmp = 0;
  else tmp = 0;
  __FC_assert(tmp != 0,"test.c",283,
              "contour.box.x == 1 && contour.box.y == 0 && contour.box.w == 4 && contour.box.h == 5");
  {
    unsigned int y = (unsigned int)0;
    while (y < visited.h) {
      {
        unsigned int x = (unsigned int)0;
        while (x < visited.w) {
          __FC_assert(((int)*(visited.data + (y * visited.w + x)) == (int)expected_visisted_data[
                       y * visited.w + x]) != 0,"test.c",285,
                      "visited.data[y * visited.w + x] == expected_visisted_data[y * visited.w + x]");
          x ++;
        }
      }
      y ++;
    }
  }
  return;
}

static void test_integral(void)
{
  uint8_t data[3 * 3] =
    {(uint8_t)1,
     (uint8_t)2,
     (uint8_t)3,
     (uint8_t)4,
     (uint8_t)5,
     (uint8_t)6,
     (uint8_t)7,
     (uint8_t)8,
     (uint8_t)9};
  struct gs_image img =
    {.w = (unsigned int)3, .h = (unsigned int)3, .data = data};
  unsigned int ii[3 * 3] = {(unsigned int)0};
  gs_integral(img,ii);
  unsigned int expected_ii[3 * 3] =
    {(unsigned int)1,
     (unsigned int)3,
     (unsigned int)6,
     (unsigned int)5,
     (unsigned int)12,
     (unsigned int)21,
     (unsigned int)12,
     (unsigned int)27,
     (unsigned int)45};
  {
    unsigned int i = (unsigned int)0;
    while (i < (unsigned int)9) {
      __FC_assert((ii[i] == expected_ii[i]) != 0,"test.c",303,
                  "ii[i] == expected_ii[i]");
      i ++;
    }
  }
  unsigned int sum =
    gs_integral_sum((unsigned int const *)(ii),(unsigned int)3,
                    (unsigned int)1,(unsigned int)1,(unsigned int)2,
                    (unsigned int)2);
  __FC_assert((sum == (unsigned int)28) != 0,"test.c",306,"sum == 28");
  return;
}

static void test_template_matching(void)
{
  uint8_t result_data[3 * 3];
  int tmp_1;
  uint8_t simple_result_data[3 * 3];
  int tmp_3;
  uint8_t data[5 * 5] =
    {(uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)100,
     (uint8_t)150,
     (uint8_t)200,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)125,
     (uint8_t)175,
     (uint8_t)225,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)110,
     (uint8_t)160,
     (uint8_t)210,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0};
  uint8_t tmpl_data[3 * 3] =
    {(uint8_t)100,
     (uint8_t)150,
     (uint8_t)200,
     (uint8_t)125,
     (uint8_t)175,
     (uint8_t)225,
     (uint8_t)110,
     (uint8_t)160,
     (uint8_t)210};
  struct gs_image img =
    {.w = (unsigned int)5, .h = (unsigned int)5, .data = data};
  struct gs_image tmpl =
    {.w = (unsigned int)3, .h = (unsigned int)3, .data = tmpl_data};
  struct gs_image result =
    {.w = (unsigned int)3, .h = (unsigned int)3, .data = result_data};
  gs_match_template(img,tmpl,result);
  struct gs_point best = gs_find_best_match(result);
  if (best.x == (unsigned int)1) 
    if (best.y == (unsigned int)1) {
      uint8_t tmp_0;
      tmp_0 = gs_get(result,best.x,best.y);
      if ((int)tmp_0 == 255) tmp_1 = 1; else tmp_1 = 0;
    }
    else tmp_1 = 0;
  else tmp_1 = 0;
  __FC_assert(tmp_1 != 0,"test.c",329,
              "best.x == 1 && best.y == 1 && gs_get(result, best.x, best.y) == 255");
  uint8_t simple_img[4 * 4] =
    {(uint8_t)50,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)50,
     (uint8_t)50};
  uint8_t simple_tmpl[2 * 2] =
    {(uint8_t)255, (uint8_t)255, (uint8_t)255, (uint8_t)255};
  struct gs_image simple =
    {.w = (unsigned int)4, .h = (unsigned int)4, .data = simple_img};
  struct gs_image simple_t =
    {.w = (unsigned int)2, .h = (unsigned int)2, .data = simple_tmpl};
  struct gs_image simple_result =
    {.w = (unsigned int)3, .h = (unsigned int)3, .data = simple_result_data};
  gs_match_template(simple,simple_t,simple_result);
  struct gs_point simple_best = gs_find_best_match(simple_result);
  if (simple_best.x == (unsigned int)1) 
    if (simple_best.y == (unsigned int)1) tmp_3 = 1; else tmp_3 = 0;
  else tmp_3 = 0;
  __FC_assert(tmp_3 != 0,"test.c",348,
              "simple_best.x == 1 && simple_best.y == 1");
  return;
}


static void test_otsu(void)
{
  uint8_t data[3 * 3] =
    {(uint8_t)40,
     (uint8_t)50,
     (uint8_t)60,
     (uint8_t)45,
     (uint8_t)55,
     (uint8_t)50,
     (uint8_t)190,
     (uint8_t)200,
     (uint8_t)210};
  struct gs_image img =
    {.w = (unsigned int)3, .h = (unsigned int)3, .data = data};
  uint8_t otsu_thresh = gs_otsu_threshold(img);
  __FC_assert(((int)otsu_thresh == 60) != 0,"test.c",185,"otsu_thresh == 60");
  uint8_t uniform_data[4] =
    {(uint8_t)0, (uint8_t)85, (uint8_t)170, (uint8_t)255};
  struct gs_image uniform_img =
    {.w = (unsigned int)2, .h = (unsigned int)2, .data = uniform_data};
  uint8_t uniform_thresh = gs_otsu_threshold(uniform_img);
  __FC_assert(((int)uniform_thresh == 85) != 0,"test.c",190,
              "uniform_thresh == 85");
  uint8_t same_data[4] =
    {(uint8_t)128, (uint8_t)128, (uint8_t)128, (uint8_t)128};
  struct gs_image same_img =
    {.w = (unsigned int)2, .h = (unsigned int)2, .data = same_data};
  uint8_t same_thresh = gs_otsu_threshold(same_img);
  __FC_assert(((int)same_thresh == 0) != 0,"test.c",195,"same_thresh == 0");
  return;
}


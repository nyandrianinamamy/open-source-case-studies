     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255};
  struct gs_image img =
    {.w = (unsigned int)6, .h = (unsigned int)5, .data = data};
  gs_label labels[6 * 5] = {(gs_label)0};
  struct gs_blob blobs[10] =
    {{.label = (gs_label)0,
      .area = 0U,
      .box = {.x = 0U, .y = 0U, .w = 0U, .h = 0U},
      .centroid = {.x = 0U, .y = 0U}}};
  unsigned int n = gs_blobs(img,labels,blobs,(unsigned int)10);
  __FC_assert((n == (unsigned int)3) != 0,"test.c",244,"n == 3");
  struct gs_blob expected[3] =
    {{.label = (gs_label)1,
      .area = (unsigned int)3,
      .box = {.x = (unsigned int)0,
              .y = (unsigned int)0,
              .w = (unsigned int)2,
              .h = (unsigned int)2},
      .centroid = {.x = (unsigned int)0, .y = (unsigned int)0}},
     {.label = (gs_label)2,
      .area = (unsigned int)9,
      .box = {.x = (unsigned int)0,
              .y = (unsigned int)0,
              .w = (unsigned int)5,
              .h = (unsigned int)5},
      .centroid = {.x = (unsigned int)2, .y = (unsigned int)2}},
     {.label = (gs_label)6,
      .area = (unsigned int)2,
      .box = {.x = (unsigned int)5,
              .y = (unsigned int)3,
              .w = (unsigned int)1,
              .h = (unsigned int)2},
      .centroid = {.x = (unsigned int)5, .y = (unsigned int)3}}};
  struct gs_blob *tmp_2 = expected;
  {
    unsigned int i = (unsigned int)0;
    while (i < n) {
      {
        int tmp_0;
        int tmp_1;
        int tmp_2_0;
        __FC_assert(((int)blobs[i].label == (int)expected[i].label) != 0,
                    "test.c",252,"blobs[i].label == expected[i].label");
        __FC_assert((blobs[i].area == expected[i].area) != 0,"test.c",253,
                    "blobs[i].area == expected[i].area");
        if (blobs[i].box.x == expected[i].box.x) 
          if (blobs[i].box.y == expected[i].box.y) tmp_0 = 1; else tmp_0 = 0;
        else tmp_0 = 0;
        __FC_assert(tmp_0 != 0,"test.c",254,
                    "blobs[i].box.x == expected[i].box.x && blobs[i].box.y == expected[i].box.y");
        if (blobs[i].box.w == expected[i].box.w) 
          if (blobs[i].box.h == expected[i].box.h) tmp_1 = 1; else tmp_1 = 0;
        else tmp_1 = 0;
        __FC_assert(tmp_1 != 0,"test.c",255,
                    "blobs[i].box.w == expected[i].box.w && blobs[i].box.h == expected[i].box.h");
        if (blobs[i].centroid.x == expected[i].centroid.x) 
          if (blobs[i].centroid.y == expected[i].centroid.y) tmp_2_0 = 1;
          else tmp_2_0 = 0;
        else tmp_2_0 = 0;
        __FC_assert(tmp_2_0 != 0,"test.c",256,
                    "blobs[i].centroid.x == expected[i].centroid.x && blobs[i].centroid.y == expected[i].centroid.y");
      }
      i ++;
    }
  }
  return;
}

static void test_trace_contour(void)
{
  struct gs_contour contour;
  int tmp;
  uint8_t data[5 * 5] =
    {(uint8_t)0,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,

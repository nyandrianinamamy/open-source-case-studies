static void test_blobs(void)
{
  uint8_t data[6 * 5] =
    {(uint8_t)255,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)255,
     (uint8_t)0,
     (uint8_t)0,
     (uint8_t)255,

static void faces(struct gs_image img, struct gs_image *out, char **argv)
{
  int tmp_0;
  if (*(argv + 0)) tmp_0 = atoi((char const *)*(argv + 0)); else tmp_0 = 1;
  int min_neighbors = tmp_0;
  if (min_neighbors <= 0) {
    fprintf(__fc_stderr,"Error: minimum neighbors must be positive\n"); /* fprintf_va_39 */
    goto return_label;
  }
  if (img.w * img.h > (unsigned int)(640 * 480)) {
    fprintf(__fc_stderr,
            "Error: Image too large for face detection (max 640x480)\n"); /* fprintf_va_40 */
    goto return_label;
  }
  gs_integral(img,faces_integral);
  unsigned int nrects =
    gs_lbp_detect(& frontalface,(unsigned int const *)(faces_integral),img.w,
                  img.h,faces_rects,(unsigned int)100,1.2f,1.0f,4.0f,
                  min_neighbors);
  *out = gs_alloc(img.w,img.h);
  gs_copy(*out,img);
  {
    unsigned int i = (unsigned int)0;
    while (i < nrects) {
      {
        struct gs_rect r = faces_rects[i];
        draw_line(*out,r.x,r.y,r.x + r.w,r.y,(uint8_t)255);
        draw_line(*out,r.x,r.y + r.h,r.x + r.w,r.y + r.h,(uint8_t)255);
        draw_line(*out,r.x,r.y,r.x,r.y + r.h,(uint8_t)255);
        draw_line(*out,r.x + r.w,r.y,r.x + r.w,r.y + r.h,(uint8_t)255);
      }
      i ++;
    }
  }
  return_label: return;
}


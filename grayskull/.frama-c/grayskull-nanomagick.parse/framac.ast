    while (level_0 < n_levels) {
      scoremaps[level_0] = buffer + buffer_offset;
      buffer_offset += pyramid[level_0].w * pyramid[level_0].h;
      level_0 ++;
    }
  }
  {
    unsigned int level_1 = (unsigned int)0;
    while (level_1 < n_levels) {
      {

                         threshold_0,scoremaps[level_1]);
        unsigned int scale = (unsigned int)(1 << level_1);
        {
          unsigned int i = total_kps;
          while (i < total_kps + level_kps) {
            (kps + i)->pt.x *= scale;
            (kps + i)->pt.y *= scale;
            i ++;
          }
        }
        total_kps += level_kps;
      }
      __Cont: level_1 ++;
    }
  }
  return total_kps;
}


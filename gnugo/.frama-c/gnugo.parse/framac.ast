void endgame(void)
{
  char an[10];
  int i;
  int j;
  int k;
  int N;
  int mtot;
  int utot;
  int cont;
  int mymovelist[19 * 19][5];
  int umovelist[19 * 19][5];
  printf("\nTo count score, we need the following steps:\n"); /* printf_va_1 */
  printf("First, I need you to remove all dead pieces on the board.\n"); /* printf_va_2 */
  printf("Second, I need you to fill in neutral territories with "); /* printf_va_3 */
  printf("pieces.\n"); /* printf_va_4 */
  printf("Last, I will fill in all pieces and announce the winner.\n"); /* printf_va_5 */
  printf("\nFirst, you should enter the dead pieces (black and white) to"); /* printf_va_6 */
  printf(" be removed.  Enter\n"); /* printf_va_7 */
  printf(" \'stop\' when you have finished.\n"); /* printf_va_8 */
  createlist(mymove,mymovelist);
  createlist(umove,umovelist);
  /*@ \eva::dynamic_split queinit; */ ;
  cont = 1;
  while (1) {
    {
      int tmp;
      printf("Dead piece? "); /* printf_va_9 */
      scanf("%s",an); /* scanf_va_1 */
      tmp = strcmp((char const *)(an),"stop");
      if (tmp) {
        getij(an,& i,& j);
        if ((int)p[i][j] == mymove) {
          N = bfslist(i,j,mymovelist,listpt);
          k = 0;
          while (k < N) {
            node2ij(listpt[k],& i,& j);
            p[i][j] = (unsigned char)0;
            mk ++;
            k ++;
          }
        }
        else 
          if ((int)p[i][j] == umove) {
            N = bfslist(i,j,umovelist,listpt);
            k = 0;
            while (k < N) {
              node2ij(listpt[k],& i,& j);
              p[i][j] = (unsigned char)0;
              uk ++;
              k ++;
            }
          }
        showboard();
      }
      else cont = 0;
    }
    if (! cont) break;
  }
  printf("Next, you need to fill in pieces (black and white) in all neutral"); /* printf_va_10 */
  printf(" territories.\n"); /* printf_va_11 */
  printf("Enter your and my pieces alternately and"); /* printf_va_12 */
  printf(" enter \'stop\' when finish\n"); /* printf_va_13 */
  cont = 1;
  N = 0;
  while (1) {
    if (N % 2 == 0) {
      int tmp_0;
      printf("Your piece? "); /* printf_va_14 */
      scanf("%s",an); /* scanf_va_2 */
      tmp_0 = strcmp((char const *)(an),"stop");
      if (tmp_0) {
        getij(an,& i,& j);
        p[i][j] = (unsigned char)umove;
        showboard();
      }
      else cont = 0;
    }
    else {
      int tmp_1;
      printf("My piece? "); /* printf_va_15 */
      scanf("%s",an); /* scanf_va_3 */
      tmp_1 = strcmp((char const *)(an),"stop");
      if (tmp_1) {
        getij(an,& i,& j);
        p[i][j] = (unsigned char)mymove;
        showboard();
      }
      else cont = 0;
    }
    N ++;
    if (! cont) break;
  }
  i = 0;
  while (i < 19) {
    j = 0;
    while (j < 19) {
      if ((int)p[i][j] == 0) {
        unsigned int tmp_2;
        tmp_2 = findcolor(i,j);
        p[i][j] = (unsigned char)tmp_2;
      }
      j ++;
    }
    i ++;
  }
  mtot = 0;
  utot = 0;
  i = 0;
  while (i < 19) {
    j = 0;
    while (j < 19) {
      if ((int)p[i][j] == mymove) mtot ++;
      else 
        if ((int)p[i][j] == umove) utot ++;
      j ++;
    }
    i ++;
  }
  showboard();
  printf("Your total number of pieces %d\n",utot); /* printf_va_16 */
  printf("My total number of pieces %d\n",mtot); /* printf_va_17 */
  return;
}

void eval(int color_0)
{
  int i;
  int j;
  i = 0;
  while (i < 19) {
    j = 0;
    while (j < 19) {
      if ((int)p[i][j] == color_0) {
        lib = 0;
        countlib(i,j,color_0);
        l[i][j] = (unsigned char)lib;
      }
      j ++;
    }
    i ++;
  }
  return;
}


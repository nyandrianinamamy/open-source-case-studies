    color_0[3] = (int)p[i][k];
  }
  else color_0[3] = (int)p[i][j];
  k = 0;
  while (k < 4) {
    if (color_0[k] == 0) goto __Cont;
    else {
      result = color_0[k];
      break;
    }
    __Cont: k ++;
  }
  k = 0;
  while (k < 4) {

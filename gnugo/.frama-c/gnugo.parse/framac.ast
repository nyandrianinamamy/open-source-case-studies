int matchpat(int m, int n, int *i, int *j, int *val)
{
  int __retres;
  int k;
  int my;
  int nx;
  int ll;
  int r;
  int cont;
  int ti;
  int tj;
  int tval;
  *i = -1;
  *j = -1;
  *val = -1;
  r = 0;
  while (r < 24) {
    ll = 0;
    while (ll < pat[r].trfno) {
      k = 0;
      cont = 1;
      while (1) {
        if (k != pat[r].patlen) {
          if (! cont) break;
        }
        else break;
        nx = (n + matchpat_trf[ll][0][0] * pat[r].patn[k].x) + matchpat_trf[ll][0][1] * pat[r].patn[k].y;
        my = (m + matchpat_trf[ll][1][0] * pat[r].patn[k].x) + matchpat_trf[ll][1][1] * pat[r].patn[k].y;
        if (my < 0) goto _LOR;
        else 
          if (my > 18) goto _LOR;
          else 
            if (nx < 0) goto _LOR;
            else 
              if (nx > 18) {
                _LOR: {
                        cont = 0;
                        break;
                      }
              }
        switch (pat[r].patn[k].att) {
          case 0: ;
          if ((int)p[my][nx] == 0) break;
          else {
            cont = 0;
            break;
          }
          case 1: ;
          if ((int)p[my][nx] == umove) break;
          else {
            cont = 0;
            break;
          }
          case 2: ;
          if ((int)p[my][nx] == mymove) break;
          else {
            cont = 0;
            break;
          }
          case 3: ;
          if ((int)p[my][nx] == 0) {
            lib = 0;
            countlib(my,nx,mymove);
            if (lib > 1) {
              ti = my;
              tj = nx;
              break;
            }
            else {
              cont = 0;
              break;
            }
          }
          else {
            cont = 0;
            break;
          }
          case 4: ;
          if ((int)p[my][nx] == 0) {
            if (my == 0) break;
            else 
              if (my == 18) break;
              else 
                if (nx == 0) break;
                else 
                  if (nx == 18) break; else goto _LAND;
          }
          else {
            _LAND: {
                     cont = 0;
                     break;
                   }
          }
          case 5: ;
          if ((int)p[my][nx] == umove) {
            if (my == 0) break;
            else 
              if (my == 18) break;
              else 
                if (nx == 0) break;
                else 
                  if (nx == 18) break; else goto _LAND_0;
          }
          else {
            _LAND_0: {
                       cont = 0;
                       break;
                     }
          }
          case 6: ;
          if ((int)p[my][nx] == mymove) {
            if (my == 0) break;
            else 
              if (my == 18) break;
              else 
                if (nx == 0) break;
                else 
                  if (nx == 18) break; else goto _LAND_1;
          }
          else {
            _LAND_1: {
                       cont = 0;
                       break;
                     }
          }
        }
        k ++;
      }
      if (cont) {
        tval = pat[r].patwt;
        if (r >= 8) 
          if (r <= 13) {
            int tmp_1;
            int tmp_4;
            if (ti - 9 < 0) tmp_1 = - (ti - 9); else tmp_1 = ti - 9;
            if (tmp_1 > 7) tval --;
            else {
              int tmp;
              if (ti - 9 < 0) tmp = - (ti - 9); else tmp = ti - 9;
              if (tmp == 6) tval ++;
              else {
                int tmp_0;
                if (ti - 9 < 0) tmp_0 = - (ti - 9); else tmp_0 = ti - 9;
                if (tmp_0 == 7) tval ++;
              }
            }
            if (tj - 9 < 0) tmp_4 = - (tj - 9); else tmp_4 = tj - 9;
            if (tmp_4 > 7) tval --;
            else {
              int tmp_2;
              if (tj - 9 < 0) tmp_2 = - (tj - 9); else tmp_2 = tj - 9;
              if (tmp_2 == 6) tval ++;
              else {
                int tmp_3;
                if (tj - 9 < 0) tmp_3 = - (tj - 9); else tmp_3 = tj - 9;
                if (tmp_3 == 7) tval ++;
              }
            }
          }
        if (tval > *val) {
          *val = tval;
          *i = ti;
          *j = tj;
        }
      }
      ll ++;
    }
    r ++;
  }
  if (*val > 0) {
    __retres = 1;
    goto return_label;
  }
  else {
    __retres = 0;
    goto return_label;
  }
  return_label: return __retres;
}


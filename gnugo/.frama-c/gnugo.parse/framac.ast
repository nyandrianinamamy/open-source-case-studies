void showinst(void)
{
  printf("XOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOX"); /* printf_va_133 */
  printf("OXOXOXOXOXOX\n"); /* printf_va_134 */
  printf("O                                                                  "); /* printf_va_135 */
  printf("           O\n"); /* printf_va_136 */
  printf("X                           GNUGO (Previously Hugo)                "); /* printf_va_137 */
  printf("           X\n"); /* printf_va_138 */
  printf("O                           the game of Go (Wei-Chi)               "); /* printf_va_139 */
  printf("           O\n"); /* printf_va_140 */
  printf("X                                                                  "); /* printf_va_141 */
  printf("           X\n"); /* printf_va_142 */
  printf("O                            version 1.2   10-31-95                "); /* printf_va_143 */
  printf("           O\n"); /* printf_va_144 */
  printf("X           Copyright (C) 1989, 1995 Free Software Foundation, Inc."); /* printf_va_145 */
  printf("           X\n"); /* printf_va_146 */
  printf("O                              Author: Man L. Li                   "); /* printf_va_147 */
  printf("           O\n"); /* printf_va_148 */
  printf("X           GNUGO comes with ABSOLUTELY NO WARRANTY; see COPYING fo"); /* printf_va_149 */
  printf("r          X\n"); /* printf_va_150 */
  printf("O           detail.   This is free software, and you are welcome to"); /* printf_va_151 */
  printf("           O\n"); /* printf_va_152 */
  printf("X           redistribute it; see COPYING for copying conditions.   "); /* printf_va_153 */
  printf("           X\n"); /* printf_va_154 */
  printf("O                                                                  "); /* printf_va_155 */
  printf("           O\n"); /* printf_va_156 */
  printf("X              Please report all bugs, modifications, suggestions  "); /* printf_va_157 */
  printf("           X\n"); /* printf_va_158 */
  printf("O                             to manli@cs.uh.edu                   "); /* printf_va_159 */
  printf("           O\n"); /* printf_va_160 */
  printf("X                                                                  "); /* printf_va_161 */
  printf("           X\n"); /* printf_va_162 */
  printf("OXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXOXO"); /* printf_va_163 */
  printf("XOXOXOXOXOXO\n"); /* printf_va_164 */
  printf("\n\n\n\n\n\n\n\nPress return to continue"); /* printf_va_165 */
  getchar();
  printf("\n\nTo play this game first select number of handicap pieces (0 to"); /* printf_va_166 */
  printf(" 17) for the\nblack side.  Next choose your color (black or white)."); /* printf_va_167 */
  printf("  To place your piece,\nenter your move as coordinate on the board"); /* printf_va_168 */
  printf(" in column and row.  The column\nis from \'A\' to \'T\'(excluding \'I\')."); /* printf_va_169 */
  printf("  The row is from 1 to 19.\n\nTo pass your move enter \'pass\' for"); /* printf_va_170 */
  printf(" your turn.  After both you and the computer\npassed the game will"); /* printf_va_171 */
  printf(" end.  To save the board and exit enter \'save\'.  The game\nwill"); /* printf_va_172 */
  printf(" continue the next time you start the program.  To stop the game in"); /* printf_va_173 */
  printf(" the\nmiddle of play enter \'stop\' for your move.  You will be"); /* printf_va_174 */
  printf(" asked whether you want\nto count the result of the game.  If you"); /* printf_va_175 */
  printf(" answer \'y\' then you need to remove the\nremaining dead pieces and"); /* printf_va_176 */
  printf(" fill up neutral turf on the board as instructed.\nFinally, the"); /* printf_va_177 */
  printf(" computer will count all pieces for both side and show the result.\n\n"); /* printf_va_178 */
  return;
}

int suicide(int i, int j)
{
  int __retres;
  int m;
  int n;
  int k;
  lib = 0;
  countlib(i,j,umove);
  if (lib == 0) {
    p[i][j] = (unsigned char)umove;
    eval(mymove);
    k = 0;
    m = 0;
    /*@ loop \eva::unroll 19; */
    while (m < 19) {
      n = 0;
      /*@ loop \eva::unroll 19; */
      while (n < 19) {
        if ((int)p[m][n] == mymove) 
          if (! l[m][n]) k ++;
        n ++;
      }
      m ++;
    }
    if (k == 0) goto _LOR;
    else 
      if (k == 1) 
        if (i == uik) 
          if (j == ujk) {
            _LOR:
            {
              p[i][j] = (unsigned char)0;
              __retres = 1;
              goto return_label;
            }
          }
          else {
            __retres = 0;
            goto return_label;
          }
        else {
          __retres = 0;
          goto return_label;
        }
      else {
        __retres = 0;
        goto return_label;
      }
  }
  else {
    __retres = 0;
    goto return_label;
  }
  return_label: return __retres;
}



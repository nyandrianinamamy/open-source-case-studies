  }
  if (i > 0) {
    k = i;
    while (1) {
      k --;
      if ((int)p[k][j] == 0) {
        if (! (k > 0)) break;
      }
      else break;
    }
    color_0[0] = (int)p[k][j];
  }
  else color_0[0] = (int)p[i][j];
  if (i < 18) {
    k = i;
    while (1) {

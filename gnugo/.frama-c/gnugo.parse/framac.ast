static int fval(int newlib, int minlib)
{
  int k;
  int val;
  if (newlib <= minlib) val = -1;
  else {
    k = newlib - minlib;
    val = 40 + ((k - 1) * 50) / ((minlib * minlib) * minlib);
  }
  return val;
}


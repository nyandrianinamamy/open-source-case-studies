int main(int argc, char **argv)
{
  int __retres;
  FILE *fp;
  int i;
  int j;
  char move[10];
  char ans[5];
  time_t tm;
  time_t tmp;
  int cont = 0;
  showinst();
  fp = fopen("gnugo.dat","r");
  if (fp != (FILE *)0) {
    cont = 1;
    i = 0;
    while (i < 19) {
      j = 0;
      while (j < 19) {
        fscanf(fp,"%c",(char *)(& p[i][j])); /* fscanf_va_1 */
        j ++;
      }
      i ++;
    }
    fscanf(fp,"%d %d %d ",& mymove,& mk,& uk); /* fscanf_va_2 */
    /*@ assert unsanitized_input: consider_ok: \subset(mymove, (1 .. 2)); */
    ;
    i = 0;
    while (i < 9) {
      fscanf(fp,"%d ",& opn[i]); /* fscanf_va_3 */
      i ++;
    }
    fclose(fp);
    umove = 3 - mymove;
    remove("gnugo.dat");
  }
  else {
    i = 0;
    while (i < 9) {
      opn[i] = 1;
      i ++;
    }
    opn[4] = 0;
    i = 0;
    while (i < 19) {
      j = 0;
      while (j < 19) {
        p[i][j] = (unsigned char)0;
        j ++;
      }
      i ++;
    }
    mk = 0;
    uk = 0;
  }
  play = 1;
  pass = 0;
  mik = -1;
  mjk = -1;
  uik = -1;
  ujk = -1;
  tmp = time(& tm);
  srand((unsigned int)tmp);
  if (! cont) {
    printf("Number of handicap for black (0 to 17)? "); /* printf_va_25 */
    scanf("%d",& i); /* scanf_va_5 */
    getchar();
    sethand(i);
    showboard();
    printf("\nChoose side(b or w)? "); /* printf_va_26 */
    scanf("%c",ans); /* scanf_va_6 */
    if ((int)ans[0] == 'b') {
      mymove = 1;
      umove = 2;
      if (i) {
        genmove(& i,& j);
        /*@ assert first_move: consider_ok: 0 ≤ i; */ ;
        p[i][j] = (unsigned char)mymove;
      }
    }
    else {
      mymove = 2;
      umove = 1;
      if (i == 0) {
        genmove(& i,& j);
        p[i][j] = (unsigned char)mymove;
      }
    }
  }
  showboard();
  while (play > 0) {
    printf("your move? "); /* printf_va_27 */
    scanf("%s",move); /* scanf_va_7 */
    getmove(move,& i,& j);
    if (play > 0) {
      if (i >= 0) {
        p[i][j] = (unsigned char)umove;
        examboard(mymove);
      }
      if (pass != 2) {
        genmove(& i,& j);
        if (i >= 0) {
          p[i][j] = (unsigned char)mymove;
          examboard(umove);
        }
      }
      showboard();
    }
    if (pass == 2) play = 0;
  }
  if (play == 0) {
    getchar();
    printf("Do you want to count score (y or n)? "); /* printf_va_28 */
    scanf("%c",ans); /* scanf_va_8 */
    if ((int)ans[0] == 'y') endgame();
  }
  __retres = 0;
  return __retres;
}


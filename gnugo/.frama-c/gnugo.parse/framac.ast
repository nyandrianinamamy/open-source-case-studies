void examboard(int color_0)
{
  int i;
  int j;
  int n;
  eval(color_0);
  if (color_0 == mymove) {
    mik = -1;
    mjk = -1;
  }
  else {
    uik = -1;
    ujk = -1;
  }
  n = 0;
  i = 0;
  /*@ loop \eva::unroll 19; */
  while (i < 19) {
    j = 0;
    /*@ loop \eva::unroll 19; */
    while (j < 19) {
      if ((int)p[i][j] == color_0) 
        if ((int)l[i][j] == 0) {
          p[i][j] = (unsigned char)0;
          if (color_0 == mymove) {
            mik = i;
            mjk = j;
            mk ++;
          }
          else {
            uik = i;
            ujk = j;
            uk ++;
          }
          n ++;
        }
      j ++;
    }
    i ++;
  }
  if (color_0 == mymove) {
    if (n > 1) {
      mik = -1;
      mjk = -1;
    }
    else goto _LAND;
  }
  else {
    _LAND: ;
    if (n > 1) {
      uik = -1;
      ujk = -1;
    }
  }
  return;
}


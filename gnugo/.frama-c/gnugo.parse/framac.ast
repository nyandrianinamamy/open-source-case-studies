    miny = i1;
    maxy = i2;
  }
  else {
    miny = i2;
    maxy = i1;
  }
  if (j1 < j2) {
    minx = j1;
    maxx = j2;
  }
  else {
    minx = j2;
    maxx = j1;
  }
  y = miny;
  while (y <= maxy) {
    x = minx;

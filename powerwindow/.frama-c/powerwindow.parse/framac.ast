void powerwindow_powerwindow_con_broadcast_ticks(powerwindow_boolean_T *rty_window_up,
                                                 powerwindow_boolean_T *rty_window_down,
                                                 powerwindow_boolean_T *rty_overcurrent,
                                                 powerwindow_boolean_T *rty_pinch,
                                                 powerwindow_boolean_T *rty_wake,
                                                 powerwindow_rtB_PowerWindow_control *localB,
                                                 powerwindow_rtDW_PowerWindow_control *localDW);

void powerwindow_powerwindow_con_broadcast_ticks(powerwindow_boolean_T *rty_window_up,
                                                 powerwindow_boolean_T *rty_window_down,
                                                 powerwindow_boolean_T *rty_overcurrent,
                                                 powerwindow_boolean_T *rty_pinch,
                                                 powerwindow_boolean_T *rty_wake,
                                                 powerwindow_rtB_PowerWindow_control *localB,
                                                 powerwindow_rtDW_PowerWindow_control *localDW)
{
  if ((unsigned int)localDW->is_active_c2_PowerWindow_contro == 0U) {
    localDW->is_active_c2_PowerWindow_contro = (powerwindow_uint8_T)1U;
    localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)3U;
    localDW->is_active_Logic = (powerwindow_uint8_T)1U;
    localDW->is_Logic = (powerwindow_uint8_T)2U;
    *rty_window_up = (powerwindow_boolean_T)0U;
    *rty_window_down = (powerwindow_boolean_T)0U;
    *rty_wake = (powerwindow_boolean_T)0U;
    localDW->is_active_Sensing = (powerwindow_uint8_T)1U;
    localDW->is_Sensing = (powerwindow_uint8_T)3U;
    localDW->temporalCounter_i2 = (powerwindow_uint8_T)0U;
    *rty_overcurrent = (powerwindow_boolean_T)0U;
    *rty_pinch = (powerwindow_boolean_T)0U;
  }
  else 
    switch ((int)localDW->is_c2_PowerWindow_control) {
      case (int)((powerwindow_uint8_T)1U): ;
      if ((int)localDW->temporalCounter_i1 >= 10) {
        localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)3U;
        localDW->is_active_Logic = (powerwindow_uint8_T)1U;
        localDW->is_Logic = (powerwindow_uint8_T)2U;
        *rty_window_up = (powerwindow_boolean_T)0U;
        *rty_window_down = (powerwindow_boolean_T)0U;
        *rty_wake = (powerwindow_boolean_T)0U;
        localDW->is_active_Sensing = (powerwindow_uint8_T)1U;
        localDW->is_Sensing = (powerwindow_uint8_T)3U;
        localDW->temporalCounter_i2 = (powerwindow_uint8_T)0U;
        *rty_overcurrent = (powerwindow_boolean_T)0U;
        *rty_pinch = (powerwindow_boolean_T)0U;
      }
      break;
      case (int)((powerwindow_uint8_T)2U): ;
      if ((int)localDW->temporalCounter_i1 >= 40) {
        localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)3U;
        localDW->is_active_Logic = (powerwindow_uint8_T)1U;
        localDW->is_Logic = (powerwindow_uint8_T)2U;
        *rty_window_up = (powerwindow_boolean_T)0U;
        *rty_window_down = (powerwindow_boolean_T)0U;
        *rty_wake = (powerwindow_boolean_T)0U;
        localDW->is_active_Sensing = (powerwindow_uint8_T)1U;
        localDW->is_Sensing = (powerwindow_uint8_T)3U;
        localDW->temporalCounter_i2 = (powerwindow_uint8_T)0U;
        *rty_overcurrent = (powerwindow_boolean_T)0U;
        *rty_pinch = (powerwindow_boolean_T)0U;
      }
      break;
      default: ;
      if ((int)*rty_pinch == 1) {
        localDW->is_Sensing = (powerwindow_uint8_T)0U;
        localDW->is_active_Sensing = (powerwindow_uint8_T)0U;
        localDW->is_Down = (powerwindow_uint8_T)0U;
        localDW->is_Logic = (powerwindow_uint8_T)0U;
        localDW->is_Up = (powerwindow_uint8_T)0U;
        localDW->is_active_Logic = (powerwindow_uint8_T)0U;
        localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)2U;
        localDW->temporalCounter_i1 = (powerwindow_uint8_T)0U;
        *rty_window_up = (powerwindow_boolean_T)0U;
        *rty_window_down = (powerwindow_boolean_T)1U;
      }
      else 
        if ((int)*rty_overcurrent == 1) {
          localDW->is_Sensing = (powerwindow_uint8_T)0U;
          localDW->is_active_Sensing = (powerwindow_uint8_T)0U;
          localDW->is_Down = (powerwindow_uint8_T)0U;
          localDW->is_Logic = (powerwindow_uint8_T)0U;
          localDW->is_Up = (powerwindow_uint8_T)0U;
          localDW->is_active_Logic = (powerwindow_uint8_T)0U;
          localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)1U;
          localDW->temporalCounter_i1 = (powerwindow_uint8_T)0U;
          *rty_window_up = (powerwindow_boolean_T)0U;
          *rty_window_down = (powerwindow_boolean_T)0U;
        }
        else {
          switch ((int)localDW->is_Logic) {
            case (int)((powerwindow_uint8_T)1U): ;
            if (localB->map[1]) {
              localDW->is_Down = (powerwindow_uint8_T)0U;
              localDW->is_Logic = (powerwindow_uint8_T)3U;
              *rty_window_up = (powerwindow_boolean_T)1U;
              *rty_window_down = (powerwindow_boolean_T)0U;
              *rty_wake = (powerwindow_boolean_T)1U;
              localDW->is_Up = (powerwindow_uint8_T)3U;
            }
            else 
              switch ((int)localDW->is_Down) {
                case (int)((powerwindow_uint8_T)1U): break;
                case (int)((powerwindow_uint8_T)2U): ;
                if (localB->map[0]) {
                  localDW->is_Down = (powerwindow_uint8_T)0U;
                  localDW->is_Logic = (powerwindow_uint8_T)2U;
                  *rty_window_up = (powerwindow_boolean_T)0U;
                  *rty_window_down = (powerwindow_boolean_T)0U;
                  *rty_wake = (powerwindow_boolean_T)0U;
                }
                break;
                default: ;
                if ((int)localDW->temporalCounter_i1 >= 20) 
                  if (localB->map[0]) localDW->is_Down = (powerwindow_uint8_T)1U;
                  else 
                    if (localB->map[2]) localDW->is_Down = (powerwindow_uint8_T)2U;
                break;
              }
            break;
            case (int)((powerwindow_uint8_T)2U): ;
            if (localB->map[1]) {
              localDW->is_Logic = (powerwindow_uint8_T)3U;
              *rty_window_up = (powerwindow_boolean_T)1U;
              *rty_window_down = (powerwindow_boolean_T)0U;
              *rty_wake = (powerwindow_boolean_T)1U;
              localDW->is_Up = (powerwindow_uint8_T)2U;
              localDW->temporalCounter_i1 = (powerwindow_uint8_T)0U;
            }
            else 
              if (localB->map[2]) {
                localDW->is_Logic = (powerwindow_uint8_T)1U;
                *rty_window_up = (powerwindow_boolean_T)0U;
                *rty_window_down = (powerwindow_boolean_T)1U;
                *rty_wake = (powerwindow_boolean_T)1U;
                localDW->is_Down = (powerwindow_uint8_T)3U;
                localDW->temporalCounter_i1 = (powerwindow_uint8_T)0U;
              }
            break;
            default: ;
            if (localB->map[2]) {
              localDW->is_Up = (powerwindow_uint8_T)0U;
              localDW->is_Logic = (powerwindow_uint8_T)1U;
              *rty_window_up = (powerwindow_boolean_T)0U;
              *rty_window_down = (powerwindow_boolean_T)1U;
              *rty_wake = (powerwindow_boolean_T)1U;
              localDW->is_Down = (powerwindow_uint8_T)2U;
            }
            else 
              switch ((int)localDW->is_Up) {
                case (int)((powerwindow_uint8_T)1U): break;
                case (int)((powerwindow_uint8_T)2U): ;
                if ((int)localDW->temporalCounter_i1 >= 20) 
                  if (localB->map[0]) localDW->is_Up = (powerwindow_uint8_T)1U;
                  else 
                    if (localB->map[1]) localDW->is_Up = (powerwindow_uint8_T)3U;
                break;
                default: ;
                if (localB->map[0]) {
                  localDW->is_Up = (powerwindow_uint8_T)0U;
                  localDW->is_Logic = (powerwindow_uint8_T)2U;
                  *rty_window_up = (powerwindow_boolean_T)0U;
                  *rty_window_down = (powerwindow_boolean_T)0U;
                  *rty_wake = (powerwindow_boolean_T)0U;
                }
                break;
              }
            break;
          }
          switch ((int)localDW->is_Sensing) {
            case (int)((powerwindow_uint8_T)1U): ;
            if ((int)localB->LogicalOperator == 0) 
              if ((int)*rty_window_up == 1) {
                localDW->is_Sensing = (powerwindow_uint8_T)3U;
                localDW->temporalCounter_i2 = (powerwindow_uint8_T)0U;
                *rty_overcurrent = (powerwindow_boolean_T)0U;
                *rty_pinch = (powerwindow_boolean_T)0U;
              }
              else *rty_overcurrent = (powerwindow_boolean_T)((int)localB->RateTransition1 > 184);
            else *rty_overcurrent = (powerwindow_boolean_T)((int)localB->RateTransition1 > 184);
            break;
            case (int)((powerwindow_uint8_T)2U): ;
            if ((int)localB->LogicalOperator == 1) goto _LOR;
            else 
              if ((int)*rty_window_down == 1) _LOR:
                                              localDW->is_Sensing = (powerwindow_uint8_T)1U;
              else *rty_pinch = (powerwindow_boolean_T)((int)localB->RateTransition1 > 92);
            break;
            default: ;
            if ((int)localDW->temporalCounter_i2 >= 6) localDW->is_Sensing = (powerwindow_uint8_T)2U;
            break;
          }
        }
      break;
    }
  return;
}

void powerwindow_powerwindow_control_Init(powerwindow_boolean_T *rty_window_up,
                                          powerwindow_boolean_T *rty_window_down,
                                          powerwindow_boolean_T *rty_overcurrent,
                                          powerwindow_boolean_T *rty_pinch,
                                          powerwindow_boolean_T *rty_wake,
                                          powerwindow_rtDW_PowerWindow_control *localDW)
{
  localDW->is_active_Logic = (powerwindow_uint8_T)0U;
  localDW->is_Logic = (powerwindow_uint8_T)0U;
  localDW->is_Down = (powerwindow_uint8_T)0U;
  localDW->is_Up = (powerwindow_uint8_T)0U;
  localDW->temporalCounter_i1 = (powerwindow_uint8_T)0U;
  localDW->is_active_Sensing = (powerwindow_uint8_T)0U;
  localDW->is_Sensing = (powerwindow_uint8_T)0U;
  localDW->temporalCounter_i2 = (powerwindow_uint8_T)0U;
  localDW->is_active_c2_PowerWindow_contro = (powerwindow_uint8_T)0U;
  localDW->is_c2_PowerWindow_control = (powerwindow_uint8_T)0U;
  *rty_window_up = (powerwindow_boolean_T)0U;
  *rty_window_down = (powerwindow_boolean_T)0U;
  *rty_overcurrent = (powerwindow_boolean_T)0U;
  *rty_pinch = (powerwindow_boolean_T)0U;
  *rty_wake = (powerwindow_boolean_T)0U;
  return;
}

void powerwindow_powerwindow_control_Start(powerwindow_rtDW_PowerWindow_control *localDW)
{
  localDW->clockTickCounter = 0L;
  return;
}

void powerwindow_powerwindow_control_main(powerwindow_boolean_T const *rtu_up,
                                          powerwindow_boolean_T const *rtu_down,
                                          powerwindow_boolean_T const *rtu_endofdetectionrange,
                                          powerwindow_uint8_T const *rtu_currentsense,
                                          powerwindow_boolean_T *rty_window_up,
                                          powerwindow_boolean_T *rty_window_down,
                                          powerwindow_boolean_T *rty_overcurrent,
                                          powerwindow_boolean_T *rty_pinch,
                                          powerwindow_boolean_T *rty_wake,
                                          powerwindow_rtB_PowerWindow_control *localB,
                                          powerwindow_rtDW_PowerWindow_control *localDW,
                                          powerwindow_rtZCE_PowerWindow_control *localZCE)
{
  powerwindow_int16_T rowIdx;
  powerwindow_int16_T rtb_periodof50ms;
  powerwindow_int16_T tmp;
  if (localDW->clockTickCounter < 5L) 
    if (localDW->clockTickCounter >= 0L) rtb_periodof50ms = 1;
    else rtb_periodof50ms = 0;
  else rtb_periodof50ms = 0;
  if (localDW->clockTickCounter >= 9L) localDW->clockTickCounter = 0L;
  else (localDW->clockTickCounter) ++;
  localB->LogicalOperator = (powerwindow_boolean_T)(! *rtu_endofdetectionrange);
  localB->RateTransition1 = *rtu_currentsense;
  rowIdx = (powerwindow_int16_T)(((powerwindow_uint16_T)*rtu_up << 1) + (powerwindow_uint16_T)*rtu_down);
  localB->map[0U] = powerwindow_rtCP_pooled_6bUUQf1tASYw[(powerwindow_uint16_T)rowIdx];
  localB->map[1U] = powerwindow_rtCP_pooled_6bUUQf1tASYw[(unsigned int)rowIdx + 4U];
  localB->map[2U] = powerwindow_rtCP_pooled_6bUUQf1tASYw[(unsigned int)rowIdx + 8U];
  if ((rtb_periodof50ms != 0) != ((unsigned int)localZCE->stateflowcontrolmodel_Trig_ZCE == 0x01U)) 
    if ((unsigned int)localZCE->stateflowcontrolmodel_Trig_ZCE != 0x03U) {
      if ((unsigned int)localDW->temporalCounter_i1 < 63U) localDW->temporalCounter_i1 = (powerwindow_uint8_T)(
                                                           (int)localDW->temporalCounter_i1 + 1);
      if ((unsigned int)localDW->temporalCounter_i2 < 7U) localDW->temporalCounter_i2 = (powerwindow_uint8_T)(
                                                          (int)localDW->temporalCounter_i2 + 1);
      powerwindow_powerwindow_con_broadcast_ticks(rty_window_up,
                                                  rty_window_down,
                                                  rty_overcurrent,rty_pinch,
                                                  rty_wake,localB,localDW);
    }
  if (rtb_periodof50ms != 0) tmp = (powerwindow_int16_T)0x01U;
  else tmp = (powerwindow_int16_T)0x00U;
  localZCE->stateflowcontrolmodel_Trig_ZCE = (powerwindow_uint8_T)tmp;
  return;
}

void powerwindow_powerwindow_control_initialize(powerwindow_char_T const **rt_errorStatus,
                                                powerwindow_RT_MODEL_PowerWindow_control * const PowerWindow_control_M,
                                                powerwindow_rtB_PowerWindow_control *localB,
                                                powerwindow_rtDW_PowerWindow_control *localDW,
                                                powerwindow_rtZCE_PowerWindow_control *localZCE)
{
  PowerWindow_control_M->errorStatus = rt_errorStatus;
  wcclib_memset((void *)localB,0,sizeof(powerwindow_rtB_PowerWindow_control));
  wcclib_memset((void *)localDW,0,
                sizeof(powerwindow_rtDW_PowerWindow_control));
  localZCE->stateflowcontrolmodel_Trig_ZCE = (ZCSigState)0x03U;
  return;
}


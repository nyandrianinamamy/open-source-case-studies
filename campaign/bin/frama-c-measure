#!/usr/bin/env bash
# Stands for frama-c in the recipes of the case studies (make FRAMAC=...).
# The invocation that runs Eva (an argument -eva) is measured when
# CAMPAIGN_MEASURE names a file: watchdog.py runs it with the wall-time
# limit CAMPAIGN_TIMEOUT in seconds (SIGTERM, then SIGKILL 60 s later if it
# is still running), with the address-space limit CAMPAIGN_MEMORY_LIMIT in
# bytes when it is set, and writes to CAMPAIGN_MEASURE its elapsed time, CPU
# times, peak resident memory, wait status, whether the watchdog fired, and
# the evidence of the out-of-memory killer it could read.
# Every other invocation runs the binary CAMPAIGN_FRAMAC unchanged.
set -euo pipefail
real=${CAMPAIGN_FRAMAC:?CAMPAIGN_FRAMAC must name the frama-c binary}
measured=false
if [[ -n ${CAMPAIGN_MEASURE:-} ]]; then
  for arg in "$@"; do
    if [[ $arg == -eva ]]; then measured=true; fi
  done
fi
if ! $measured; then
  exec "$real" "$@"
fi
exec python3 -I "$(dirname "$(realpath "$0")")/watchdog.py" \
  "$CAMPAIGN_MEASURE" "${CAMPAIGN_TIMEOUT:?}" 60 \
  "${CAMPAIGN_MEMORY_LIMIT:--}" -- "$real" "$@"

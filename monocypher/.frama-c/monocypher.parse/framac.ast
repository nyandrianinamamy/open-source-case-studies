  ctx->hash[3] = 0xa54ff53a5f1d36f1;
  ctx->hash[4] = (unsigned long)0x510e527fade682d1;
  ctx->hash[5] = 0x9b05688c2b3e6c1f;
  ctx->hash[6] = (unsigned long)0x1f83d9abfb41bd6b;
  ctx->hash[7] = (unsigned long)0x5be0cd19137e2179;
  ctx->input_size[0] = (unsigned long)0;
  ctx->input_size[1] = (unsigned long)0;
  ctx->input_idx = (unsigned long)0;
  return;
}

void crypto_sha512_update(crypto_sha512_ctx *ctx, uint8_t const *message,
                          size_t message_size)
{
  unsigned long tmp;
  if (((~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1)) <= message_size) 
    tmp = (~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1);
  else tmp = message_size;
  size_t align = tmp;
  sha512_update(ctx,message,align);
  message += align;
  message_size -= align;
  {
    size_t i = (unsigned long)0;
    while (i < message_size / (size_t)128) {
      {
        size_t j = (unsigned long)0;
        while (j < (size_t)16) {
          ctx->input[j] = load64_be(message + j * (size_t)8);
          j += (size_t)1;
        }
      }
      message += 128;
      ctx->input_idx += (size_t)128;
      sha512_end_block(ctx);
      i += (size_t)1;
    }
  }
  message_size &= (unsigned long)127;
  sha512_update(ctx,message,message_size);
  return;
}

void crypto_sha512_final(crypto_sha512_ctx *ctx, uint8_t * /*[64]*/ hash)
{
  sha512_incr(ctx->input_size,ctx->input_idx * (size_t)8);
  sha512_set_input(ctx,(unsigned char)128);
  if (ctx->input_idx > (size_t)111) {
    sha512_compress(ctx);
    {
      size_t i = (unsigned long)0;
      while (i < (size_t)14) {
        ctx->input[i] = (unsigned long)0;
        i += (size_t)1;
      }
    }
  }
  ctx->input[14] = ctx->input_size[0];
  ctx->input[15] = ctx->input_size[1];
  sha512_compress(ctx);
  {
    size_t i_0 = (unsigned long)0;
    while (i_0 < (size_t)8) {
      store64_be(hash + i_0 * (size_t)8,ctx->hash[i_0]);
      i_0 += (size_t)1;
    }
  }
  crypto_wipe_0((void *)ctx,sizeof(*ctx));
  return;
}

void crypto_sha512(uint8_t *hash, uint8_t const *message, size_t message_size)
{
  crypto_sha512_ctx ctx;
  crypto_sha512_init(& ctx);
  crypto_sha512_update(& ctx,message,message_size);
  crypto_sha512_final(& ctx,hash);
  return;
}

static void store64_le_0(u8 * /*[8]*/ out, u64 in)
{
  *(out + 0) = (unsigned char)(in & (unsigned long)0xff);
  *(out + 1) = (unsigned char)((in >> 8) & (unsigned long)0xff);
  *(out + 2) = (unsigned char)((in >> 16) & (unsigned long)0xff);
  *(out + 3) = (unsigned char)((in >> 24) & (unsigned long)0xff);
  *(out + 4) = (unsigned char)((in >> 32) & (unsigned long)0xff);
  *(out + 5) = (unsigned char)((in >> 40) & (unsigned long)0xff);
  *(out + 6) = (unsigned char)((in >> 48) & (unsigned long)0xff);
  *(out + 7) = (unsigned char)((in >> 56) & (unsigned long)0xff);

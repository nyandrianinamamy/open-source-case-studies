  v9 += v14;
  v4 = rotr64(v4 ^ v9,(unsigned long)24);
  v3 += v4 + *(input + blake2b_compress_sigma[0][15]);
  v14 = rotr64(v14 ^ v3,(unsigned long)16);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(unsigned long)63);
  v0 += v4 + *(input + blake2b_compress_sigma[1][0]);
  v12 = rotr64(v12 ^ v0,(unsigned long)32);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(unsigned long)24);
  v0 += v4 + *(input + blake2b_compress_sigma[1][1]);
  v12 = rotr64(v12 ^ v0,(unsigned long)16);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(unsigned long)63);
  v1 += v5 + *(input + blake2b_compress_sigma[1][2]);
  v13 = rotr64(v13 ^ v1,(unsigned long)32);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(unsigned long)24);
  v1 += v5 + *(input + blake2b_compress_sigma[1][3]);
  v13 = rotr64(v13 ^ v1,(unsigned long)16);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(unsigned long)63);
  v2 += v6 + *(input + blake2b_compress_sigma[1][4]);
  v14 = rotr64(v14 ^ v2,(unsigned long)32);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(unsigned long)24);
  v2 += v6 + *(input + blake2b_compress_sigma[1][5]);
  v14 = rotr64(v14 ^ v2,(unsigned long)16);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(unsigned long)63);
  v3 += v7 + *(input + blake2b_compress_sigma[1][6]);
  v15 = rotr64(v15 ^ v3,(unsigned long)32);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(unsigned long)24);
  v3 += v7 + *(input + blake2b_compress_sigma[1][7]);
  v15 = rotr64(v15 ^ v3,(unsigned long)16);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(unsigned long)63);
  v0 += v5 + *(input + blake2b_compress_sigma[1][8]);
  v15 = rotr64(v15 ^ v0,(unsigned long)32);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(unsigned long)24);
  v0 += v5 + *(input + blake2b_compress_sigma[1][9]);
  v15 = rotr64(v15 ^ v0,(unsigned long)16);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(unsigned long)63);
  v1 += v6 + *(input + blake2b_compress_sigma[1][10]);
  v12 = rotr64(v12 ^ v1,(unsigned long)32);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(unsigned long)24);
  v1 += v6 + *(input + blake2b_compress_sigma[1][11]);
  v12 = rotr64(v12 ^ v1,(unsigned long)16);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(unsigned long)63);
  v2 += v7 + *(input + blake2b_compress_sigma[1][12]);
  v13 = rotr64(v13 ^ v2,(unsigned long)32);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(unsigned long)24);
  v2 += v7 + *(input + blake2b_compress_sigma[1][13]);
  v13 = rotr64(v13 ^ v2,(unsigned long)16);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(unsigned long)63);

   (unsigned long)0x5be0cd19137e2179};
static void blake2b_incr(crypto_blake2b_ctx *ctx)
{
  u64 *x = ctx->input_offset;
  size_t y = ctx->input_idx;
  *(x + 0) += y;
  if (*(x + 0) < y) *(x + 1) += (u64)1;
  return;
}


static void ge_scalarmult_base(ge *p, u8 const scalar[32])
{
  u8 s_scalar[32];
  fe yp;
  fe ym;
  fe t2;
  fe n2;
  fe a;
  fe b;
  ge dbl;
  mul_add(s_scalar,scalar,ge_scalarmult_base_half_mod_L,
          ge_scalarmult_base_half_ones);
  ge_zero(p);
  {
    int i = 50;
    while (i >= 0) {
      {
        int tmp;
        int tmp_0;
        int tmp_1;
        int tmp_2;
        int tmp_3;
        if (i < 50) ge_double(p,(ge const *)p,& dbl);
        fe_1(yp);
        fe_1(ym);
        fe_0(t2);
        tmp = scalar_bit((u8 const *)(s_scalar),i);
        tmp_0 = scalar_bit((u8 const *)(s_scalar),i + 51);
        tmp_1 = scalar_bit((u8 const *)(s_scalar),i + 102);
        tmp_2 = scalar_bit((u8 const *)(s_scalar),i + 153);
        tmp_3 = scalar_bit((u8 const *)(s_scalar),i + 204);
        u8 teeth =
          (u8)((((tmp + (tmp_0 << 1)) + (tmp_1 << 2)) + (tmp_2 << 3)) + (
               tmp_3 << 4));
        u8 high = (u8)((int)teeth >> 4);
        u8 index_0 = (u8)(((int)teeth ^ ((int)high - 1)) & 15);
        {
          size_t j = (size_t)0;
          while (j < (size_t)16) {
            {
              i32 select =
                (i32)((unsigned long)1 & (((j ^ (unsigned long)index_0) - (unsigned long)1) >> 8));
              fe_ccopy(yp,comb_Yp[j],select);
              fe_ccopy(ym,comb_Ym[j],select);
              fe_ccopy(t2,comb_T2[j],select);
            }
            j ++;
          }
        }
        fe_neg(n2,(i32 const *)(t2));
        fe_cswap(t2,n2,(int)high);
        fe_cswap(yp,ym,(int)high);
        ge_madd(p,(ge const *)p,(i32 const *)(ym),(i32 const *)(yp),
                (i32 const *)(n2),a,b);
      }
      i --;
    }
  }
  crypto_wipe((void *)(& dbl),sizeof(dbl));
  crypto_wipe((void *)(a),sizeof(a));
  crypto_wipe((void *)(yp),sizeof(yp));
  crypto_wipe((void *)(t2),sizeof(t2));
  crypto_wipe((void *)(b),sizeof(b));
  crypto_wipe((void *)(ym),sizeof(ym));
  crypto_wipe((void *)(n2),sizeof(n2));
  crypto_wipe((void *)(s_scalar),sizeof(s_scalar));
  return;
}

void crypto_sign_public_key(uint8_t public_key[32],
                            uint8_t const secret_key[32])
{
  u8 a[64];
  ge A;
  crypto_blake2b(a,secret_key,(size_t)32);
  trim_scalar(a);
  ge_scalarmult_base(& A,(u8 const *)(a));
  ge_tobytes(public_key,(ge const *)(& A));
  crypto_wipe((void *)(a),sizeof(a));
  crypto_wipe((void *)(& A),sizeof(A));
  return;
}

void crypto_sign_init_first_pass(crypto_sign_ctx *ctx,
                                 uint8_t const secret_key[32],
                                 uint8_t const public_key[32])
{
  u8 *a = ctx->buf;
  u8 *prefix = & ctx->buf[32];
  crypto_blake2b(a,secret_key,(size_t)32);
  trim_scalar(a);
  if (public_key == (uint8_t const *)0) crypto_sign_public_key(ctx->pk,
                                                               secret_key);
  else {
    size_t i = (size_t)0;
    while (i < (size_t)32) {
      ctx->pk[i] = *(public_key + i);
      i ++;
    }
  }
  crypto_blake2b_init(& ctx->hash);
  crypto_blake2b_update(& ctx->hash,(uint8_t const *)prefix,(size_t)32);
  return;
}

void crypto_sign_update(crypto_sign_ctx *ctx, uint8_t const *msg,
                        size_t msg_size)
{
  crypto_blake2b_update(& ctx->hash,msg,msg_size);
  return;
}

void crypto_sign_init_second_pass(crypto_sign_ctx *ctx)
{
  ge R;
  u8 *r = & ctx->buf[32];
  u8 *half_sig = & ctx->buf[64];
  crypto_blake2b_final(& ctx->hash,r);
  reduce(r);
  ge_scalarmult_base(& R,(u8 const *)r);
  ge_tobytes(half_sig,(ge const *)(& R));
  crypto_wipe((void *)(& R),sizeof(R));
  crypto_blake2b_init(& ctx->hash);
  crypto_blake2b_update(& ctx->hash,(uint8_t const *)half_sig,(size_t)32);
  crypto_blake2b_update(& ctx->hash,(uint8_t const *)(ctx->pk),(size_t)32);
  return;
}

void crypto_sign_final(crypto_sign_ctx *ctx, uint8_t signature[64])
{
  u8 h_ram[64];
  u8 *a = ctx->buf;
  u8 *r = & ctx->buf[32];
  u8 *half_sig = & ctx->buf[64];
  crypto_blake2b_final(& ctx->hash,h_ram);
  reduce(h_ram);
  {
    size_t i = (size_t)0;
    while (i < (size_t)32) {
      *(signature + i) = *(half_sig + i);
      i ++;
    }
  }
  mul_add(signature + 32,(u8 const *)(h_ram),(u8 const *)a,(u8 const *)r);
  crypto_wipe((void *)ctx,sizeof(*ctx));
  crypto_wipe((void *)(h_ram),sizeof(h_ram));
  return;
}

void crypto_sign(uint8_t signature[64], uint8_t const secret_key[32],
                 uint8_t const public_key[32], uint8_t const *message,
                 size_t message_size)
{
  crypto_sign_ctx ctx;
  crypto_sign_init_first_pass(& ctx,secret_key,public_key);
  crypto_sign_update(& ctx,message,message_size);
  crypto_sign_init_second_pass(& ctx);
  crypto_sign_update(& ctx,message,message_size);
  crypto_sign_final(& ctx,signature);
  return;
}

void crypto_check_init(crypto_check_ctx *ctx, uint8_t const signature[64],
                       uint8_t const public_key[32])
{
  {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 64; */
    while (i < (size_t)64) {
      ctx->sig[i] = *(signature + i);
      i ++;
    }
  }
  {
    size_t i_0 = (size_t)0;
    /*@ loop \eva::unroll 32; */
    while (i_0 < (size_t)32) {
      ctx->pk[i_0] = *(public_key + i_0);
      i_0 ++;
    }
  }
  crypto_blake2b_init(& ctx->hash);
  crypto_blake2b_update(& ctx->hash,signature,(size_t)32);
  crypto_blake2b_update(& ctx->hash,public_key,(size_t)32);
  return;
}

void crypto_check_update(crypto_check_ctx *ctx, uint8_t const *msg,
                         size_t msg_size)
{
  crypto_blake2b_update(& ctx->hash,msg,msg_size);
  return;
}

int crypto_check_final(crypto_check_ctx *ctx)
{
  int __retres;
  ge diff;
  ge A;
  u8 h_ram[64];
  u8 R_check[32];
  int tmp;
  int tmp_1;
  u8 *s = & ctx->sig[32];
  u8 *R = ctx->sig;
  tmp = ge_frombytes_neg_vartime(& A,(u8 const *)(ctx->pk));
  if (tmp) goto _LOR;
  else {
    int tmp_0;
    tmp_0 = is_above_L((u8 const *)s);
    if (tmp_0) {
      _LOR: {
              __retres = -1;
              goto return_label;
            }
    }
  }
  crypto_blake2b_final(& ctx->hash,h_ram);
  reduce(h_ram);
  ge_double_scalarmult_vartime(& diff,(ge const *)(& A),h_ram,s);
  ge_tobytes(R_check,(ge const *)(& diff));
  tmp_1 = crypto_verify32((uint8_t const *)R,(uint8_t const *)(R_check));
  __retres = tmp_1;
  return_label: return __retres;
}

int crypto_check(uint8_t const signature[64], uint8_t const public_key[32],
                 uint8_t const *message, size_t message_size)
{
  crypto_check_ctx ctx;
  int tmp;
  crypto_check_init(& ctx,signature,public_key);
  crypto_check_update(& ctx,message,message_size);
  tmp = crypto_check_final(& ctx);
  return tmp;
}

int crypto_key_exchange(uint8_t shared_key[32],
                        uint8_t const your_secret_key[32],
                        uint8_t const their_public_key[32])
{
  u8 raw_shared_secret[32];
  int status =
    crypto_x25519(raw_shared_secret,your_secret_key,their_public_key);
  crypto_chacha20_H(shared_key,(uint8_t const *)(raw_shared_secret),zero);
  crypto_wipe((void *)(raw_shared_secret),sizeof(raw_shared_secret));
  return status;
}

static void lock_ad_padding(crypto_lock_ctx *ctx)
{
  if (ctx->ad_phase) {
    ctx->ad_phase = 0;
    crypto_poly1305_update(& ctx->poly,zero,
                           (~ ctx->ad_size + (uint64_t)1) & (unsigned long)(
                           16 - 1));
  }
  return;
}

void crypto_lock_init(crypto_lock_ctx *ctx, uint8_t const key[32],
                      uint8_t const nonce[24])
{
  u8 auth_key[64];
  ctx->ad_phase = 1;
  ctx->ad_size = (uint64_t)0;
  ctx->message_size = (uint64_t)0;
  crypto_chacha20_x_init(& ctx->chacha,key,nonce);
  crypto_chacha20_stream(& ctx->chacha,auth_key,(size_t)64);
  crypto_poly1305_init(& ctx->poly,(uint8_t const *)(auth_key));
  crypto_wipe((void *)(auth_key),sizeof(auth_key));
  return;
}

void crypto_lock_auth_ad(crypto_lock_ctx *ctx, uint8_t const *msg,
                         size_t msg_size)
{
  crypto_poly1305_update(& ctx->poly,msg,msg_size);
  ctx->ad_size += msg_size;
  return;
}

void crypto_lock_auth_message(crypto_lock_ctx *ctx,
                              uint8_t const *cipher_text, size_t text_size)
{
  lock_ad_padding(ctx);
  ctx->message_size += text_size;
  crypto_poly1305_update(& ctx->poly,cipher_text,text_size);
  return;
}

void crypto_lock_update(crypto_lock_ctx *ctx, uint8_t *cipher_text,
                        uint8_t const *plain_text, size_t text_size)
{
  crypto_chacha20_encrypt(& ctx->chacha,cipher_text,plain_text,text_size);
  crypto_lock_auth_message(ctx,(uint8_t const *)cipher_text,text_size);
  return;
}

void crypto_lock_final(crypto_lock_ctx *ctx, uint8_t mac[16])
{
  u8 sizes[16];
  lock_ad_padding(ctx);
  store64_le(& sizes[0],ctx->ad_size);
  store64_le(& sizes[8],ctx->message_size);
  crypto_poly1305_update(& ctx->poly,zero,
                         (~ ctx->message_size + (uint64_t)1) & (unsigned long)(
                         16 - 1));
  crypto_poly1305_update(& ctx->poly,(uint8_t const *)(sizes),(size_t)16);
  crypto_poly1305_final(& ctx->poly,mac);
  crypto_wipe((void *)ctx,sizeof(*ctx));
  return;
}

void crypto_unlock_update(crypto_lock_ctx *ctx, uint8_t *plain_text,
                          uint8_t const *cipher_text, size_t text_size)
{
  crypto_lock_auth_message(ctx,cipher_text,text_size);
  crypto_chacha20_encrypt(& ctx->chacha,plain_text,cipher_text,text_size);
  return;
}

int crypto_unlock_final(crypto_lock_ctx *ctx, uint8_t const mac[16])
{
  u8 real_mac[16];
  crypto_lock_final(ctx,real_mac);
  int mismatch = crypto_verify16((uint8_t const *)(real_mac),mac);
  crypto_wipe((void *)(real_mac),sizeof(real_mac));
  return mismatch;
}

void crypto_lock_aead(uint8_t mac[16], uint8_t *cipher_text,
                      uint8_t const key[32], uint8_t const nonce[24],
                      uint8_t const *ad, size_t ad_size,
                      uint8_t const *plain_text, size_t text_size)
{
  crypto_lock_ctx ctx;
  crypto_lock_init(& ctx,key,nonce);
  crypto_lock_auth_ad(& ctx,ad,ad_size);
  crypto_lock_update(& ctx,cipher_text,plain_text,text_size);
  crypto_lock_final(& ctx,mac);
  return;
}

int crypto_unlock_aead(uint8_t *plain_text, uint8_t const key[32],
                       uint8_t const nonce[24], uint8_t const mac[16],
                       uint8_t const *ad, size_t ad_size,
                       uint8_t const *cipher_text, size_t text_size)
{
  int __retres;
  crypto_lock_ctx ctx;
  int tmp;
  crypto_lock_init(& ctx,key,nonce);
  crypto_lock_auth_ad(& ctx,ad,ad_size);
  crypto_lock_auth_message(& ctx,cipher_text,text_size);
  crypto_chacha_ctx chacha_ctx = ctx.chacha;
  tmp = crypto_unlock_final(& ctx,mac);
  if (tmp) {
    crypto_wipe((void *)(& chacha_ctx),sizeof(chacha_ctx));
    __retres = -1;
    goto return_label;
  }
  crypto_chacha20_encrypt(& chacha_ctx,plain_text,cipher_text,text_size);
  crypto_wipe((void *)(& chacha_ctx),sizeof(chacha_ctx));
  __retres = 0;
  return_label: return __retres;
}

void crypto_lock(uint8_t mac[16], uint8_t *cipher_text,
                 uint8_t const key[32], uint8_t const nonce[24],
                 uint8_t const *plain_text, size_t text_size)
{
  crypto_lock_aead(mac,cipher_text,key,nonce,(uint8_t const *)0,(size_t)0,
                   plain_text,text_size);
  return;
}

int crypto_unlock(uint8_t *plain_text, uint8_t const key[32],
                  uint8_t const nonce[24], uint8_t const mac[16],
                  uint8_t const *cipher_text, size_t text_size)
{
  int tmp;
  tmp = crypto_unlock_aead(plain_text,key,nonce,mac,(uint8_t const *)0,
                           (size_t)0,cipher_text,text_size);
  return tmp;
}

void crypto_sha512_init(crypto_sha512_ctx *ctx);

void crypto_sha512_update(crypto_sha512_ctx *ctx, uint8_t const *message,
                          size_t message_size);

void crypto_sha512_final(crypto_sha512_ctx *ctx, uint8_t hash[64]);

void crypto_sha512(uint8_t *hash, uint8_t const *message, size_t message_size);

static u64 load64_be(u8 const s[8])
{
  u64 __retres;
  __retres = ((((((((u64)*(s + 0) << 56) | ((u64)*(s + 1) << 48)) | (
                  (u64)*(s + 2) << 40)) | ((u64)*(s + 3) << 32)) | ((u64)*(
                                                                    s + 4) << 24)) | (
               (u64)*(s + 5) << 16)) | ((u64)*(s + 6) << 8)) | (u64)*(
             s + 7);
  return __retres;
}

static void store64_be(u8 out[8], u64 in)
{
  *(out + 0) = (u8)((in >> 56) & (unsigned long)0xff);
  *(out + 1) = (u8)((in >> 48) & (unsigned long)0xff);
  *(out + 2) = (u8)((in >> 40) & (unsigned long)0xff);
  *(out + 3) = (u8)((in >> 32) & (unsigned long)0xff);
  *(out + 4) = (u8)((in >> 24) & (unsigned long)0xff);
  *(out + 5) = (u8)((in >> 16) & (unsigned long)0xff);
  *(out + 6) = (u8)((in >> 8) & (unsigned long)0xff);
  *(out + 7) = (u8)(in & (unsigned long)0xff);
  return;
}

static void crypto_wipe_0(void *secret, size_t size)
{
  u8 volatile *v_secret = (u8 volatile *)secret;
  {
    size_t i = (size_t)0;
    while (i < size) {
      *(v_secret + i) = (u8)0;
      i ++;
    }
  }
  return;
}

static u64 rot(u64 x, int c)
{
  u64 __retres;
  __retres = (x >> c) | (x << (64 - c));
  return __retres;
}

static u64 ch(u64 x, u64 y, u64 z)
{
  u64 __retres;
  __retres = (x & y) ^ (~ x & z);

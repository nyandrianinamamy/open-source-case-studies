static void sha512_compress(crypto_sha512_ctx *ctx)
{
  u64 *w = ctx->w;
  {
    size_t i = (unsigned long)0;
    while (i < (size_t)16) {
      *(w + i) = ctx->input[i];
      i += (size_t)1;
    }
  }
  {
    size_t i_0 = (unsigned long)16;
    while (i_0 < (size_t)80) {
      {
        u64 tmp;
        u64 tmp_0;
        tmp = lit_sigma1(*(w + (i_0 - (size_t)2)));
        tmp_0 = lit_sigma0(*(w + (i_0 - (size_t)15)));
        *(w + i_0) = ((tmp + *(w + (i_0 - (size_t)7))) + tmp_0) + *(w + (
                                                                    i_0 - (size_t)16));
      }
      i_0 += (size_t)1;
    }
  }
  u64 a = ctx->hash[0];
  u64 b = ctx->hash[1];
  u64 c = ctx->hash[2];
  u64 d = ctx->hash[3];
  u64 e = ctx->hash[4];
  u64 f = ctx->hash[5];
  u64 g = ctx->hash[6];
  u64 h = ctx->hash[7];
  {
    size_t i_1 = (unsigned long)0;
    while (i_1 < (size_t)80) {
      {
        u64 tmp_1;
        u64 tmp_2;
        u64 tmp_3;
        u64 tmp_4;
        tmp_1 = big_sigma1(e);
        tmp_2 = ch(e,f,g);
        u64 t1 = (((tmp_1 + tmp_2) + h) + K[i_1]) + *(w + i_1);
        tmp_3 = big_sigma0(a);
        tmp_4 = maj(a,b,c);
        u64 t2 = tmp_3 + tmp_4;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
      }
      i_1 += (size_t)1;
    }
  }
  ctx->hash[0] += a;
  ctx->hash[1] += b;
  ctx->hash[2] += c;
  ctx->hash[3] += d;
  ctx->hash[4] += e;
  ctx->hash[5] += f;
  ctx->hash[6] += g;
  ctx->hash[7] += h;
  return;
}

static void sha512_set_input(crypto_sha512_ctx *ctx, u8 input)
{
  if (ctx->input_idx == (size_t)0) {
    size_t i = (unsigned long)0;
    while (i < (size_t)16) {
      ctx->input[i] = (unsigned long)0;
      i += (size_t)1;
    }
  }
  size_t word = ctx->input_idx / (size_t)8;
  size_t byte = ctx->input_idx % (unsigned long)8;
  ctx->input[word] |= (unsigned long)input << (size_t)8 * ((size_t)7 - byte);
  return;
}

static void sha512_incr(u64 * /*[2]*/ x, u64 y)
{
  *(x + 1) += y;
  if (*(x + 1) < y) *(x + 0) += (u64)1;
  return;
}

static void sha512_end_block(crypto_sha512_ctx *ctx)
{
  if (ctx->input_idx == (size_t)128) {
    sha512_incr(ctx->input_size,(unsigned long)1024);
    sha512_compress(ctx);
    ctx->input_idx = (unsigned long)0;
  }
  return;
}

static void sha512_update(crypto_sha512_ctx *ctx, u8 const *message,
                          size_t message_size)
{
  size_t i = (unsigned long)0;
  while (i < message_size) {
    sha512_set_input(ctx,*(message + i));
    ctx->input_idx += (size_t)1;
    sha512_end_block(ctx);
    i += (size_t)1;
  }
  return;
}

void crypto_sha512_init(crypto_sha512_ctx *ctx)
{
  ctx->hash[0] = (unsigned long)0x6a09e667f3bcc908;

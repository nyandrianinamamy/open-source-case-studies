static void fe_ccopy(i32 f[10], i32 const g[10], int b)
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 10; */
  while (i < (size_t)10) {
    {
      i32 x = (*(f + i) ^ *(g + i)) & - b;
      *(f + i) ^= x;
    }
    i ++;

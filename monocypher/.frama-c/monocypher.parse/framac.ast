        tmp_0 = lit_sigma0(*(w + (i_0 - (size_t)15)));
        *(w + i_0) = ((tmp + *(w + (i_0 - (size_t)7))) + tmp_0) + *(w + (
                                                                    i_0 - (size_t)16));
      }
      i_0 ++;
    }
  }
  u64 a = ctx->hash[0];
  u64 b = ctx->hash[1];
  u64 c = ctx->hash[2];
  u64 d = ctx->hash[3];
  u64 e = ctx->hash[4];
  u64 f = ctx->hash[5];
  u64 g = ctx->hash[6];
  u64 h = ctx->hash[7];
  {
    size_t i_1 = (size_t)0;
    while (i_1 < (size_t)80) {

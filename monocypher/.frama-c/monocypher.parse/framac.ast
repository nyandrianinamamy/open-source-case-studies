  h6 -= c6 * (i64)(1 << 26);
  c3 = (h3 + (i64)(1 << 24)) >> 25;
  h4 += c3;
  h3 -= c3 * (i64)(1 << 25);
  c7 = (h7 + (i64)(1 << 24)) >> 25;
  h8 += c7;
  h7 -= c7 * (i64)(1 << 25);
  c4 = (h4 + (i64)(1 << 25)) >> 26;

            __fc_stdout->__fc_FILE_data, (indirect: *(format + (0 ..)));
 */
int printf_va_2(char const * restrict format);

void print_vector(u8 *buf, size_t size)
{
  {
    size_t i = (size_t)0;
    while (i < size) {
      printf("%hhx%hhx",(int)*(buf + i) >> 4,(int)*(buf + i) & 0x0f); /* printf_va_1 */
      i ++;
    }
  }
  printf(":\n"); /* printf_va_2 */
  return;
}

void print_number(u64 n)
{
  u8 buf[8];
  store64_le_0(buf,n);
  print_vector(buf,(size_t)8);
  return;
}


static void trim_scalar(u8 * /*[32]*/ s)
{
  *(s + 0) = (unsigned char)((int)*(s + 0) & 248);
  *(s + 31) = (unsigned char)((int)*(s + 31) & 127);
  *(s + 31) = (unsigned char)((int)*(s + 31) | 64);

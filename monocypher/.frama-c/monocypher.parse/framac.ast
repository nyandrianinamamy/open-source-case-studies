  {
    size_t i_1 = (size_t)0;
    /*@ loop \eva::unroll 32; */
    while (i_1 < (size_t)32) {
      *(x + i_1) = (i64)((u64)*(x + i_1) - (u64)carry_0 * L[i_1]);
      i_1 ++;
    }
  }
  {
    size_t i_2 = (size_t)0;
    /*@ loop \eva::unroll 32; */
    while (i_2 < (size_t)32) {
      *(x + (i_2 + (size_t)1)) += *(x + i_2) >> 8;
      *(r + i_2) = (u8)(*(x + i_2) & (long)255);
      i_2 ++;
    }
  }
  return;
}

static void reduce(u8 r[64])
{
  i64 x[64];
  {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 64; */
    while (i < (size_t)64) {
      x[i] = (i64)((u64)*(r + i));
      *(r + i) = (u8)0;
      i ++;
    }
  }
  modL(r,x);
  crypto_wipe((void *)(x),sizeof(x));
  return;
}

static void mul_add(u8 r[32], u8 const a[32], u8 const b[32], u8 const c[32])
{
  i64 s[64];

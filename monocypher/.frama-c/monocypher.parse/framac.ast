      work_block->a[i_0 + 17] += work_block->a[i_0 + 32] + ((unsigned long)2 * (
                                                            work_block->a[
                                                            i_0 + 17] & (unsigned long)0xffffffff)) * (
                                                           work_block->a[
                                                           i_0 + 32] & (unsigned long)0xffffffff);
      work_block->a[i_0 + 112] ^= work_block->a[i_0 + 17];
      work_block->a[i_0 + 112] = rotr64(work_block->a[i_0 + 112],
                                        (unsigned long)16);
      work_block->a[i_0 + 65] += work_block->a[i_0 + 112] + ((unsigned long)2 * (
                                                             work_block->a[
                                                             i_0 + 65] & (unsigned long)0xffffffff)) * (
                                                            work_block->a[
                                                            i_0 + 112] & (unsigned long)0xffffffff);
      work_block->a[i_0 + 32] ^= work_block->a[i_0 + 65];
      work_block->a[i_0 + 32] = rotr64(work_block->a[i_0 + 32],
                                       (unsigned long)63);
      i_0 += 2;
    }
  }
  return;
}

static void g_copy(block *result, block const *x, block const *y, block *tmp)
{
  copy_block(tmp,x);
  xor_block(tmp,y);
  copy_block(result,(block const *)tmp);
  g_rounds(tmp);
  xor_block(result,(block const *)tmp);
  return;
}

static void g_xor(block *result, block const *x, block const *y, block *tmp)
{
  copy_block(tmp,x);
  xor_block(tmp,y);
  xor_block(result,(block const *)tmp);
  g_rounds(tmp);
  xor_block(result,(block const *)tmp);
  return;
}

static void unary_g(block *work_block)
{
  block tmp;
  copy_block(& tmp,(block const *)work_block);
  g_rounds(work_block);
  xor_block(work_block,(block const *)(& tmp));
  wipe_block(& tmp);
  return;
}

static void gidx_refresh(gidx_ctx *ctx)
{
  ctx->b.a[0] = (unsigned long)ctx->pass_number;
  ctx->b.a[1] = (unsigned long)0;
  ctx->b.a[2] = (unsigned long)ctx->slice_number;
  ctx->b.a[3] = (unsigned long)ctx->nb_blocks;
  ctx->b.a[4] = (unsigned long)ctx->nb_iterations;
  ctx->b.a[5] = (unsigned long)1;
  ctx->b.a[6] = (unsigned long)ctx->ctr;
  {
    size_t i = (unsigned long)7;
    while (i < (size_t)128) {
      ctx->b.a[i] = (unsigned long)0;
      i += (size_t)1;
    }
  }
  unary_g(& ctx->b);
  unary_g(& ctx->b);
  return;
}

static void gidx_init(gidx_ctx *ctx, u32 pass_number, u32 slice_number,
                      u32 nb_blocks, u32 nb_iterations)
{
  ctx->pass_number = pass_number;
  ctx->slice_number = slice_number;
  ctx->nb_blocks = nb_blocks;
  ctx->nb_iterations = nb_iterations;
  ctx->ctr = (unsigned int)0;
  if (pass_number != (u32)0) goto _LOR;
  else 
    if (slice_number != (u32)0) _LOR: ctx->offset = (unsigned int)0;
    else {
      ctx->offset = (unsigned int)2;
      ctx->ctr += (u32)1;
      gidx_refresh(ctx);
    }
  return;
}

static u32 gidx_next(gidx_ctx *ctx)
{
  u32 __retres;
  u32 tmp;
  u32 tmp_0;
  if ((ctx->offset & (unsigned int)127) == (unsigned int)0) {
    ctx->ctr += (u32)1;
    gidx_refresh(ctx);
  }
  u32 index_0 = ctx->offset & (unsigned int)127;
  u32 offset = ctx->offset;
  ctx->offset += (u32)1;
  int first_pass = ctx->pass_number == (u32)0;
  u32 slice_size = ctx->nb_blocks >> 2;
  if (first_pass) tmp = ctx->slice_number; else tmp = (unsigned int)3;
  u32 nb_segments = tmp;
  u32 area_size = (nb_segments * slice_size + offset) - (u32)1;
  u32 next_slice =
    ((ctx->slice_number + (u32)1) & (unsigned int)3) * slice_size;
  if (first_pass) tmp_0 = (unsigned int)0; else tmp_0 = next_slice;
  u32 start_pos = tmp_0;
  u64 j1 = ctx->b.a[index_0] & (unsigned long)0xffffffff;
  u64 x = j1 * j1 >> 32;
  u64 y = (u64)area_size * x >> 32;
  u64 z = (u64)(area_size - (u32)1) - y;
  __retres = (unsigned int)(((u64)start_pos + z) % (unsigned long)ctx->nb_blocks);
  return __retres;
}

void crypto_argon2i_general(uint8_t *hash, uint32_t hash_size,
                            void *work_area, uint32_t nb_blocks,
                            uint32_t nb_iterations, uint8_t const *password,
                            uint32_t password_size, uint8_t const *salt,
                            uint32_t salt_size, uint8_t const *key,
                            uint32_t key_size, uint8_t const *ad,
                            uint32_t ad_size)
{
  block tmp;
  gidx_ctx ctx_0;
  u8 final_block[1024];
  block *blocks = (block *)work_area;
  {
    crypto_blake2b_ctx ctx;
    u8 initial_hash[72];
    block tmp_block;
    u8 hash_area[1024];
    crypto_blake2b_init(& ctx);
    blake_update_32(& ctx,(unsigned int)1);
    blake_update_32(& ctx,hash_size);
    blake_update_32(& ctx,nb_blocks);
    blake_update_32(& ctx,nb_iterations);
    blake_update_32(& ctx,(unsigned int)0x13);
    blake_update_32(& ctx,(unsigned int)1);
    blake_update_32(& ctx,password_size);
    crypto_blake2b_update(& ctx,password,(unsigned long)password_size);
    blake_update_32(& ctx,salt_size);
    crypto_blake2b_update(& ctx,salt,(unsigned long)salt_size);
    blake_update_32(& ctx,key_size);
    crypto_blake2b_update(& ctx,key,(unsigned long)key_size);
    blake_update_32(& ctx,ad_size);
    crypto_blake2b_update(& ctx,ad,(unsigned long)ad_size);
    crypto_blake2b_final(& ctx,initial_hash);
    store32_le(& initial_hash[64],(unsigned int)0);
    store32_le(& initial_hash[68],(unsigned int)0);
    extended_hash(hash_area,(unsigned int)1024,(u8 const *)(initial_hash),
                  (unsigned int)72);
    load_block(& tmp_block,(u8 const *)(hash_area));
    copy_block(blocks,(block const *)(& tmp_block));
    store32_le(& initial_hash[64],(unsigned int)1);
    extended_hash(hash_area,(unsigned int)1024,(u8 const *)(initial_hash),
                  (unsigned int)72);
    load_block(& tmp_block,(u8 const *)(hash_area));
    copy_block(blocks + 1,(block const *)(& tmp_block));
    crypto_wipe((void *)(initial_hash),sizeof(initial_hash));
    crypto_wipe((void *)(hash_area),sizeof(hash_area));
    wipe_block(& tmp_block);
  }
  nb_blocks -= nb_blocks & (unsigned int)3;
  u32 const segment_size = nb_blocks >> 2;
  {
    size_t pass_number = (unsigned long)0;
    while (pass_number < (size_t)nb_iterations) {
      {
        int first_pass = pass_number == (size_t)0;
        {
          size_t segment = (unsigned long)0;
          while (segment < (size_t)4) {
            {
              int tmp_0;
              gidx_init(& ctx_0,(unsigned int)pass_number,
                        (unsigned int)segment,nb_blocks,nb_iterations);
              if (first_pass) 
                if (segment == (size_t)0) tmp_0 = 2; else tmp_0 = 0;
              else tmp_0 = 0;
              u32 start_offset = (unsigned int)tmp_0;
              u32 segment_start =
                (unsigned int)segment * segment_size + start_offset;
              u32 segment_end =
                ((unsigned int)segment + (unsigned int)1) * segment_size;
              {
                size_t current_block = (unsigned long)segment_start;
                while (current_block < (size_t)segment_end) {
                  {
                    uint32_t tmp_2;
                    u32 reference_block = gidx_next(& ctx_0);
                    if (current_block == (size_t)0) tmp_2 = nb_blocks - (uint32_t)1;
                    else tmp_2 = (unsigned int)current_block - (unsigned int)1;
                    u32 previous_block = tmp_2;
                    block *c = blocks + current_block;
                    block *p = blocks + previous_block;
                    block *r = blocks + reference_block;
                    if (first_pass) g_copy(c,(block const *)p,
                                           (block const *)r,& tmp);
                    else g_xor(c,(block const *)p,(block const *)r,& tmp);
                  }
                  current_block += (size_t)1;
                }
              }
            }
            segment += (size_t)1;
          }
        }
      }
      pass_number += (size_t)1;
    }
  }
  wipe_block(& ctx_0.b);
  wipe_block(& tmp);
  store_block(final_block,
              (block const *)(blocks + (nb_blocks - (uint32_t)1)));
  extended_hash(hash,hash_size,(u8 const *)(final_block),(unsigned int)1024);
  crypto_wipe((void *)(final_block),sizeof(final_block));
  u64 volatile *p_0 = (u64 volatile *)work_area;
  {
    size_t i = (unsigned long)0;
    while (i < (size_t)((uint32_t)128 * nb_blocks)) {
      *(p_0 + i) = (unsigned long)0;
      i += (size_t)1;
    }
  }
  return;
}

void crypto_argon2i(uint8_t *hash, uint32_t hash_size, void *work_area,
                    uint32_t nb_blocks, uint32_t nb_iterations,
                    uint8_t const *password, uint32_t password_size,
                    uint8_t const *salt, uint32_t salt_size)
{
  crypto_argon2i_general(hash,hash_size,work_area,nb_blocks,nb_iterations,
                         password,password_size,salt,salt_size,
                         (uint8_t const *)0,(unsigned int)0,
                         (uint8_t const *)0,(unsigned int)0);
  return;
}

static void fe_0(i32 * /*[10]*/ h)
{
  size_t i = (unsigned long)0;
  /*@ loop unroll 10; */
  while (i < (size_t)10) {
    *(h + i) = 0;
    i += (size_t)1;
  }
  return;
}

static void fe_1(i32 * /*[10]*/ h)
{

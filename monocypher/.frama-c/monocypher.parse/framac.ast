    size_t i = (unsigned long)0;
    /*@ loop unroll 4; */
    while (i < text_size >> 6) {
      chacha20_refill_pool(ctx);
      if (plain_text != (uint8_t const *)0) {
        size_t j = (unsigned long)0;
        /*@ loop unroll 16; */
        while (j < (size_t)16) {
          {
            u32 plain = load32_le(plain_text);
            store32_le(cipher_text,ctx->pool[j] ^ plain);
            plain_text += 4;
            cipher_text += 4;
          }
          j += (size_t)1;
        }
      }
      else {
        size_t j_0 = (unsigned long)0;
        /*@ loop unroll 16; */
        while (j_0 < (size_t)16) {
          store32_le(cipher_text,ctx->pool[j_0]);
          cipher_text += 4;
          j_0 += (size_t)1;
        }
      }
      ctx->pool_idx = (unsigned long)64;
      i += (size_t)1;
    }
  }
  text_size &= (unsigned long)63;
  chacha20_encrypt(ctx,cipher_text,plain_text,text_size);
  return;
}

void crypto_chacha20_stream(crypto_chacha_ctx *ctx, uint8_t *stream,
                            size_t size)
{
  crypto_chacha20_encrypt(ctx,stream,(uint8_t const *)0,size);
  return;
}

static void poly_block(crypto_poly1305_ctx *ctx)
{
  u64 const s0 = (unsigned long)ctx->h[0] + (unsigned long)ctx->c[0];
  u64 const s1 = (unsigned long)ctx->h[1] + (unsigned long)ctx->c[1];
  u64 const s2 = (unsigned long)ctx->h[2] + (unsigned long)ctx->c[2];
  u64 const s3 = (unsigned long)ctx->h[3] + (unsigned long)ctx->c[3];
  u32 const s4 = ctx->h[4] + ctx->c[4];
  u32 const r0 = ctx->r[0];
  u32 const r1 = ctx->r[1];
  u32 const r2 = ctx->r[2];
  u32 const r3 = ctx->r[3];
  u32 const rr0 = (r0 >> 2) * (u32)5;
  u32 const rr1 = (r1 >> 2) + r1;
  u32 const rr2 = (r2 >> 2) + r2;
  u32 const rr3 = (r3 >> 2) + r3;
  u64 const x0 =
    (((s0 * (u64)r0 + s1 * (u64)rr3) + s2 * (u64)rr2) + s3 * (u64)rr1) + (u64)(
    s4 * rr0);
  u64 const x1 =
    (((s0 * (u64)r1 + s1 * (u64)r0) + s2 * (u64)rr3) + s3 * (u64)rr2) + (u64)(
    s4 * rr1);
  u64 const x2 =
    (((s0 * (u64)r2 + s1 * (u64)r1) + s2 * (u64)r0) + s3 * (u64)rr3) + (u64)(
    s4 * rr2);
  u64 const x3 =
    (((s0 * (u64)r3 + s1 * (u64)r2) + s2 * (u64)r1) + s3 * (u64)r0) + (u64)(
    s4 * rr3);
  u32 const x4 = s4 * (r0 & (unsigned int)3);
  u32 const u5 = (unsigned int)((u64)x4 + (x3 >> 32));
  u64 const u0 =
    (unsigned long)((u5 >> 2) * (u32)5) + (x0 & (unsigned long)0xffffffff);
  u64 const u1 =
    ((u0 >> 32) + (x1 & (unsigned long)0xffffffff)) + (x0 >> 32);
  u64 const u2 =
    ((u1 >> 32) + (x2 & (unsigned long)0xffffffff)) + (x1 >> 32);
  u64 const u3 =
    ((u2 >> 32) + (x3 & (unsigned long)0xffffffff)) + (x2 >> 32);
  u64 const u4 = (u3 >> 32) + (u64)(u5 & (unsigned int)3);
  ctx->h[0] = (unsigned int)(u0 & (unsigned long)0xffffffff);
  ctx->h[1] = (unsigned int)(u1 & (unsigned long)0xffffffff);
  ctx->h[2] = (unsigned int)(u2 & (unsigned long)0xffffffff);
  ctx->h[3] = (unsigned int)(u3 & (unsigned long)0xffffffff);
  ctx->h[4] = (unsigned int)u4;
  return;
}

static void poly_clear_c(crypto_poly1305_ctx *ctx)
{
  ctx->c[0] = (unsigned int)0;
  ctx->c[1] = (unsigned int)0;
  ctx->c[2] = (unsigned int)0;
  ctx->c[3] = (unsigned int)0;
  ctx->c_idx = (unsigned long)0;
  return;
}

static void poly_take_input(crypto_poly1305_ctx *ctx, u8 input)
{
  size_t word = ctx->c_idx >> 2;
  size_t byte = ctx->c_idx & (unsigned long)3;
  ctx->c[word] |= (unsigned int)input << byte * (size_t)8;
  ctx->c_idx += (size_t)1;
  return;
}

static void poly_update(crypto_poly1305_ctx *ctx, u8 const *message,
                        size_t message_size)
{
  size_t i = (unsigned long)0;
  /*@ loop unroll 15; */
  while (i < message_size) {
    poly_take_input(ctx,*(message + i));
    if (ctx->c_idx == (size_t)16) {
      poly_block(ctx);
      poly_clear_c(ctx);
    }
    i += (size_t)1;
  }
  return;
}

void crypto_poly1305_init(crypto_poly1305_ctx *ctx,
                          uint8_t const * /*[32]*/ key)
{
  {
    size_t i = (unsigned long)0;
    /*@ loop unroll 5; */
    while (i < (size_t)5) {
      ctx->h[i] = (unsigned int)0;
      i += (size_t)1;
    }
  }
  ctx->c[4] = (unsigned int)1;
  poly_clear_c(ctx);
  {
    size_t i_0 = (unsigned long)0;
    while (i_0 < (size_t)1) {
      {
        u32 tmp;
        tmp = load32_le(key);
        ctx->r[0] = tmp & (unsigned int)0x0fffffff;
      }
      i_0 += (size_t)1;
    }
  }
  {
    size_t i_1 = (unsigned long)1;
    /*@ loop unroll 3; */
    while (i_1 < (size_t)4) {
      {
        u32 tmp_0;
        tmp_0 = load32_le(key + i_1 * (size_t)4);
        ctx->r[i_1] = tmp_0 & (unsigned int)0x0ffffffc;
      }
      i_1 += (size_t)1;
    }
  }
  {
    size_t i_2 = (unsigned long)0;
    /*@ loop unroll 4; */
    while (i_2 < (size_t)4) {
      ctx->pad[i_2] = load32_le((key + i_2 * (size_t)4) + 16);
      i_2 += (size_t)1;
    }
  }
  return;
}

void crypto_poly1305_update(crypto_poly1305_ctx *ctx, uint8_t const *message,
                            size_t message_size)
{
  unsigned long tmp;
  if (((~ ctx->c_idx + (size_t)1) & (unsigned long)(16 - 1)) <= message_size) 
    tmp = (~ ctx->c_idx + (size_t)1) & (unsigned long)(16 - 1);
  else tmp = message_size;
  size_t align = tmp;
  poly_update(ctx,message,align);
  message += align;
  message_size -= align;
  size_t nb_blocks = message_size >> 4;
  {
    size_t i = (unsigned long)0;
    while (i < nb_blocks) {
      ctx->c[0] = load32_le(message + 0);
      ctx->c[1] = load32_le(message + 4);
      ctx->c[2] = load32_le(message + 8);
      ctx->c[3] = load32_le(message + 12);
      poly_block(ctx);
      message += 16;
      i += (size_t)1;
    }
  }
  if (nb_blocks > (size_t)0) poly_clear_c(ctx);
  message_size &= (unsigned long)15;
  poly_update(ctx,message,message_size);
  return;
}

void crypto_poly1305_final(crypto_poly1305_ctx *ctx, uint8_t * /*[16]*/ mac)
{
  if (ctx->c_idx != (size_t)0) {
    ctx->c[4] = (unsigned int)0;
    poly_take_input(ctx,(unsigned char)1);
    poly_block(ctx);
  }
  u64 const u0 = (unsigned long)5 + (unsigned long)ctx->h[0];
  u64 const u1 = (u0 >> 32) + (u64)ctx->h[1];
  u64 const u2 = (u1 >> 32) + (u64)ctx->h[2];
  u64 const u3 = (u2 >> 32) + (u64)ctx->h[3];
  u64 const u4 = (u3 >> 32) + (u64)ctx->h[4];
  u64 const uu0 = ((u4 >> 2) * (u64)5 + (u64)ctx->h[0]) + (u64)ctx->pad[0];
  u64 const uu1 = ((uu0 >> 32) + (u64)ctx->h[1]) + (u64)ctx->pad[1];
  u64 const uu2 = ((uu1 >> 32) + (u64)ctx->h[2]) + (u64)ctx->pad[2];
  u64 const uu3 = ((uu2 >> 32) + (u64)ctx->h[3]) + (u64)ctx->pad[3];
  store32_le(mac,(unsigned int)uu0);
  store32_le(mac + 4,(unsigned int)uu1);
  store32_le(mac + 8,(unsigned int)uu2);
  store32_le(mac + 12,(unsigned int)uu3);
  crypto_wipe((void *)ctx,sizeof(*ctx));
  return;
}

void crypto_poly1305(uint8_t * /*[16]*/ mac, uint8_t const *message,
                     size_t message_size, uint8_t const * /*[32]*/ key)
{
  crypto_poly1305_ctx ctx;
  crypto_poly1305_init(& ctx,key);
  crypto_poly1305_update(& ctx,message,message_size);
  crypto_poly1305_final(& ctx,mac);
  return;
}


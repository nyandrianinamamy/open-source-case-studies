static void fe_sub(i32 h[10], i32 const f[10], i32 const g[10])
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 10; */
  while (i < (size_t)10) {
    *(h + i) = *(f + i) - *(g + i);
    i ++;

  size_t i = (unsigned long)0;
  /*@ loop unroll 10; */
  while (i < (size_t)10) {
    *(h + i) = *(f + i) - *(g + i);
    i += (size_t)1;
  }
  return;
}

static void fe_cswap(i32 * /*[10]*/ f, i32 * /*[10]*/ g, int b)
{
  size_t i = (unsigned long)0;
  /*@ loop unroll 10; */
  while (i < (size_t)10) {
    {
      i32 x = (*(f + i) ^ *(g + i)) & - b;
      *(f + i) ^= x;
      *(g + i) ^= x;
    }
    i += (size_t)1;
  }
  return;
}

static void fe_ccopy(i32 * /*[10]*/ f, i32 const * /*[10]*/ g, int b)

  i64 h5 =
    ((((i64)f0_2 * (i64)f5 + (i64)f1_2 * (i64)f4) + (i64)f2_2 * (i64)f3) + 
     (i64)f6 * (i64)f9_38) + (i64)f7_2 * (i64)f8_19;

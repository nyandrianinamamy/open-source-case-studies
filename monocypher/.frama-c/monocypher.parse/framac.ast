        while (j < (size_t)32) {
          s[i_1 + j] = (i64)((u64)s[i_1 + j] + (u64)*(a + i_1) * (u64)*(
                                               b + j));
          j ++;
        }
      }
      i_1 ++;
    }
  }
  modL(r,s);
  crypto_wipe((void *)(s),sizeof(s));
  return;
}

static int is_above_L(u8 const a[32])
{
  int __retres;
  {
    int i = 31;
    /*@ loop \eva::unroll 32; */
    while (i >= 0) {
      if ((u64)*(a + i) > L[i]) {
        __retres = 1;
        goto return_label;
      }
      if ((u64)*(a + i) < L[i]) {
        __retres = 0;
        goto return_label;
      }
      i --;
    }
  }
  __retres = 1;
  return_label: return __retres;
}

static void ge_zero(ge *p)
{
  fe_0(p->X);
  fe_1(p->Y);
  fe_1(p->Z);
  fe_0(p->T);
  return;
}

static void ge_tobytes(u8 s[32], ge const *h)
{
  fe recip;
  fe x;
  fe y;
  int tmp;
  fe_invert(recip,h->Z);
  fe_mul(x,h->X,(i32 const *)(recip));
  fe_mul(y,h->Y,(i32 const *)(recip));
  fe_tobytes(s,(i32 const *)(y));
  tmp = fe_isnegative((i32 const *)(x));
  *(s + 31) = (u8)((int)*(s + 31) ^ (tmp << 7));
  crypto_wipe((void *)(recip),sizeof(recip));
  crypto_wipe((void *)(x),sizeof(x));
  crypto_wipe((void *)(y),sizeof(y));
  return;
}


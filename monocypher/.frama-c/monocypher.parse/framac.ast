  {
    size_t i = (size_t)0;
    while (i < (size_t)4) {
      ctx.input[i + (size_t)12] = load32_le(in + i * (size_t)4);
      i ++;
    }
  }
  chacha20_rounds(buffer,(u32 const *)(ctx.input));
  {
    size_t i_0 = (size_t)0;
    while (i_0 < (size_t)4) {
      store32_le(out + i_0 * (size_t)4,buffer[i_0]);
      store32_le((out + 16) + i_0 * (size_t)4,buffer[i_0 + (size_t)12]);
      i_0 ++;
    }
  }
  crypto_wipe((void *)(& ctx),sizeof(ctx));
  crypto_wipe((void *)(buffer),sizeof(buffer));
  return;
}

static void chacha20_encrypt(crypto_chacha_ctx *ctx, u8 *cipher_text,
                             u8 const *plain_text, size_t text_size)
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 64; */
  while (i < text_size) {
    {
      u8 tmp;
      if (ctx->pool_idx == (size_t)64) chacha20_refill_pool(ctx);
      u8 plain = (u8)0;
      if (plain_text != (u8 const *)0) {
        plain = *plain_text;
        plain_text ++;
      }
      tmp = chacha20_pool_byte(ctx);
      *cipher_text = (u8)((int)tmp ^ (int)plain);
      cipher_text ++;
    }
    i ++;
  }
  return;
}

void crypto_chacha20_init(crypto_chacha_ctx *ctx, uint8_t const key[32],
                          uint8_t const nonce[8])
{
  chacha20_init_key(ctx,key);

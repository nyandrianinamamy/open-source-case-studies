}

static void sha512_set_input(crypto_sha512_ctx *ctx, u8 input)
{
  if (ctx->input_idx == (size_t)0) {
    size_t i = (size_t)0;
    while (i < (size_t)16) {
      ctx->input[i] = (uint64_t)0;
      i ++;
    }
  }
  size_t word = ctx->input_idx / (size_t)8;
  size_t byte = ctx->input_idx % (unsigned long)8;
  ctx->input[word] |= (u64)input << (size_t)8 * ((size_t)7 - byte);
  return;
}

static void sha512_incr(u64 x[2], u64 y)
{
  *(x + 1) += y;
  if (*(x + 1) < y) (*(x + 0)) ++;
  return;
}

static void sha512_end_block(crypto_sha512_ctx *ctx)
{
  if (ctx->input_idx == (size_t)128) {
    sha512_incr(ctx->input_size,(u64)1024);
    sha512_compress(ctx);
    ctx->input_idx = (size_t)0;

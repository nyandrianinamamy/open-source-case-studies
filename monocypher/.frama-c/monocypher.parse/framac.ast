static void fe_sq2(i32 h[10], i32 const f[10])
{
  fe_sq(h,f);
  fe_mul_small(h,(i32 const *)h,2);
  return;
}

static void fe_invert(i32 out[10], i32 const z[10])
{
  fe t0;
  fe t1;
  fe t2;
  fe t3;
  fe_sq(t0,z);
  fe_sq(t1,(i32 const *)(t0));
  fe_sq(t1,(i32 const *)(t1));
  fe_mul(t1,z,(i32 const *)(t1));
  fe_mul(t0,(i32 const *)(t0),(i32 const *)(t1));
  fe_sq(t2,(i32 const *)(t0));
  fe_mul(t1,(i32 const *)(t1),(i32 const *)(t2));
  fe_sq(t2,(i32 const *)(t1));
  {
    size_t i = (size_t)1;
    while (i < (size_t)5) {
      fe_sq(t2,(i32 const *)(t2));
      i ++;
    }
  }
  fe_mul(t1,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t2,(i32 const *)(t1));
  {
    size_t i_0 = (size_t)1;
    while (i_0 < (size_t)10) {
      fe_sq(t2,(i32 const *)(t2));
      i_0 ++;
    }
  }
  fe_mul(t2,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t3,(i32 const *)(t2));
  {
    size_t i_1 = (size_t)1;
    while (i_1 < (size_t)20) {
      fe_sq(t3,(i32 const *)(t3));
      i_1 ++;
    }
  }
  fe_mul(t2,(i32 const *)(t3),(i32 const *)(t2));
  fe_sq(t2,(i32 const *)(t2));
  {
    size_t i_2 = (size_t)1;
    while (i_2 < (size_t)10) {
      fe_sq(t2,(i32 const *)(t2));
      i_2 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t2,(i32 const *)(t1));
  {
    size_t i_3 = (size_t)1;
    while (i_3 < (size_t)50) {
      fe_sq(t2,(i32 const *)(t2));
      i_3 ++;
    }
  }
  fe_mul(t2,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t3,(i32 const *)(t2));
  {
    size_t i_4 = (size_t)1;
    while (i_4 < (size_t)100) {
      fe_sq(t3,(i32 const *)(t3));
      i_4 ++;
    }
  }
  fe_mul(t2,(i32 const *)(t3),(i32 const *)(t2));
  fe_sq(t2,(i32 const *)(t2));
  {
    size_t i_5 = (size_t)1;
    while (i_5 < (size_t)50) {
      fe_sq(t2,(i32 const *)(t2));
      i_5 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t1,(i32 const *)(t1));
  {
    size_t i_6 = (size_t)1;
    while (i_6 < (size_t)5) {
      fe_sq(t1,(i32 const *)(t1));
      i_6 ++;
    }
  }
  fe_mul(out,(i32 const *)(t1),(i32 const *)(t0));
  crypto_wipe((void *)(t0),sizeof(t0));
  crypto_wipe((void *)(t1),sizeof(t1));
  crypto_wipe((void *)(t2),sizeof(t2));
  crypto_wipe((void *)(t3),sizeof(t3));
  return;
}

static void fe_pow22523(i32 out[10], i32 const z[10])
{
  fe t0;
  fe t1;
  fe t2;
  fe_sq(t0,z);
  fe_sq(t1,(i32 const *)(t0));
  fe_sq(t1,(i32 const *)(t1));
  fe_mul(t1,z,(i32 const *)(t1));
  fe_mul(t0,(i32 const *)(t0),(i32 const *)(t1));
  fe_sq(t0,(i32 const *)(t0));
  fe_mul(t0,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t1,(i32 const *)(t0));
  {
    size_t i = (size_t)1;
    /*@ loop \eva::unroll 5; */
    while (i < (size_t)5) {
      fe_sq(t1,(i32 const *)(t1));
      i ++;
    }
  }
  fe_mul(t0,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t1,(i32 const *)(t0));
  {
    size_t i_0 = (size_t)1;
    /*@ loop \eva::unroll 10; */
    while (i_0 < (size_t)10) {
      fe_sq(t1,(i32 const *)(t1));
      i_0 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t2,(i32 const *)(t1));
  {
    size_t i_1 = (size_t)1;
    /*@ loop \eva::unroll 20; */
    while (i_1 < (size_t)20) {
      fe_sq(t2,(i32 const *)(t2));
      i_1 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t1,(i32 const *)(t1));
  {
    size_t i_2 = (size_t)1;
    /*@ loop \eva::unroll 10; */
    while (i_2 < (size_t)10) {
      fe_sq(t1,(i32 const *)(t1));
      i_2 ++;
    }
  }
  fe_mul(t0,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t1,(i32 const *)(t0));
  {
    size_t i_3 = (size_t)1;
    /*@ loop \eva::unroll 50; */
    while (i_3 < (size_t)50) {
      fe_sq(t1,(i32 const *)(t1));
      i_3 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t2,(i32 const *)(t1));
  {
    size_t i_4 = (size_t)1;
    /*@ loop \eva::unroll 100; */
    while (i_4 < (size_t)100) {
      fe_sq(t2,(i32 const *)(t2));
      i_4 ++;
    }
  }
  fe_mul(t1,(i32 const *)(t2),(i32 const *)(t1));
  fe_sq(t1,(i32 const *)(t1));
  {
    size_t i_5 = (size_t)1;
    /*@ loop \eva::unroll 50; */
    while (i_5 < (size_t)50) {
      fe_sq(t1,(i32 const *)(t1));
      i_5 ++;
    }
  }
  fe_mul(t0,(i32 const *)(t1),(i32 const *)(t0));
  fe_sq(t0,(i32 const *)(t0));
  {
    size_t i_6 = (size_t)1;
    /*@ loop \eva::unroll 2; */
    while (i_6 < (size_t)2) {
      fe_sq(t0,(i32 const *)(t0));
      i_6 ++;
    }
  }
  fe_mul(out,(i32 const *)(t0),z);
  crypto_wipe((void *)(t0),sizeof(t0));
  crypto_wipe((void *)(t1),sizeof(t1));
  crypto_wipe((void *)(t2),sizeof(t2));
  return;
}

static void fe_tobytes(u8 s[32], i32 const h[10])
{
  i32 t[10];
  {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 10; */
    while (i < (size_t)10) {
      t[i] = *(h + i);
      i ++;
    }
  }
  i32 q = (19 * t[9] + (1 << 24)) >> 25;
  {
    size_t i_0 = (size_t)0;
    /*@ loop \eva::unroll 5; */
    while (i_0 < (size_t)5) {
      q += t[(size_t)2 * i_0];
      q >>= 26;
      q += t[(size_t)2 * i_0 + (size_t)1];
      q >>= 25;
      i_0 ++;
    }
  }
  t[0] += 19 * q;
  i32 c0 = t[0] >> 26;
  t[1] += c0;
  t[0] -= c0 * (1 << 26);
  i32 c1 = t[1] >> 25;
  t[2] += c1;
  t[1] -= c1 * (1 << 25);
  i32 c2 = t[2] >> 26;
  t[3] += c2;
  t[2] -= c2 * (1 << 26);
  i32 c3 = t[3] >> 25;
  t[4] += c3;
  t[3] -= c3 * (1 << 25);
  i32 c4 = t[4] >> 26;
  t[5] += c4;
  t[4] -= c4 * (1 << 26);
  i32 c5 = t[5] >> 25;
  t[6] += c5;
  t[5] -= c5 * (1 << 25);
  i32 c6 = t[6] >> 26;
  t[7] += c6;
  t[6] -= c6 * (1 << 26);
  i32 c7 = t[7] >> 25;
  t[8] += c7;
  t[7] -= c7 * (1 << 25);
  i32 c8 = t[8] >> 26;
  t[9] += c8;
  t[8] -= c8 * (1 << 26);
  i32 c9 = t[9] >> 25;
  t[9] -= c9 * (1 << 25);
  store32_le(s + 0,((u32)t[0] >> 0) | ((u32)t[1] << 26));
  store32_le(s + 4,((u32)t[1] >> 6) | ((u32)t[2] << 19));
  store32_le(s + 8,((u32)t[2] >> 13) | ((u32)t[3] << 13));
  store32_le(s + 12,((u32)t[3] >> 19) | ((u32)t[4] << 6));
  store32_le(s + 16,((u32)t[5] >> 0) | ((u32)t[6] << 25));
  store32_le(s + 20,((u32)t[6] >> 7) | ((u32)t[7] << 19));
  store32_le(s + 24,((u32)t[7] >> 13) | ((u32)t[8] << 12));
  store32_le(s + 28,((u32)t[8] >> 20) | ((u32)t[9] << 6));
  crypto_wipe((void *)(t),sizeof(t));
  return;
}

static int fe_isnegative(i32 const f[10])
{
  int __retres;
  u8 s[32];
  fe_tobytes(s,f);
  u8 isneg = (u8)((int)s[0] & 1);
  crypto_wipe((void *)(s),sizeof(s));
  __retres = (int)isneg;
  return __retres;
}

static int fe_isnonzero(i32 const f[10])
{
  int __retres;
  u8 s[32];
  int tmp;
  fe_tobytes(s,f);
  tmp = zerocmp32((u8 const *)(s));
  u8 isnonzero = (u8)tmp;
  crypto_wipe((void *)(s),sizeof(s));
  __retres = (int)isnonzero;
  return __retres;
}

static void trim_scalar(u8 s[32])
{
  *(s + 0) = (u8)((int)*(s + 0) & 248);
  *(s + 31) = (u8)((int)*(s + 31) & 127);
  *(s + 31) = (u8)((int)*(s + 31) | 64);
  return;
}

static int scalar_bit(u8 const s[32], int i)
{
  int __retres;
  __retres = ((int)*(s + (i >> 3)) >> (i & 7)) & 1;
  return __retres;
}

int crypto_x25519(uint8_t raw_shared_secret[32],
                  uint8_t const your_secret_key[32],
                  uint8_t const their_public_key[32])
{
  int __retres;
  fe x1;
  u8 e[32];
  fe x2;
  fe z2;
  fe x3;
  fe z3;
  fe t0;
  fe t1;
  int tmp_0;
  fe_frombytes(x1,their_public_key);
  {
    size_t i = (size_t)0;
    while (i < (size_t)32) {
      e[i] = *(your_secret_key + i);
      i ++;
    }
  }
  trim_scalar(e);
  fe_1(x2);
  fe_0(z2);
  fe_copy(x3,(i32 const *)(x1));
  fe_1(z3);
  int swap = 0;
  {
    int pos = 254;
    while (pos >= 0) {
      {
        int b = scalar_bit((u8 const *)(e),pos);
        swap ^= b;
        fe_cswap(x2,x3,swap);
        fe_cswap(z2,z3,swap);
        swap = b;
        fe_sub(t0,(i32 const *)(x3),(i32 const *)(z3));
        fe_sub(t1,(i32 const *)(x2),(i32 const *)(z2));
        fe_add(x2,(i32 const *)(x2),(i32 const *)(z2));
        fe_add(z2,(i32 const *)(x3),(i32 const *)(z3));
        fe_mul(z3,(i32 const *)(t0),(i32 const *)(x2));
        fe_mul(z2,(i32 const *)(z2),(i32 const *)(t1));
        fe_sq(t0,(i32 const *)(t1));
        fe_sq(t1,(i32 const *)(x2));
        fe_add(x3,(i32 const *)(z3),(i32 const *)(z2));
        fe_sub(z2,(i32 const *)(z3),(i32 const *)(z2));
        fe_mul(x2,(i32 const *)(t1),(i32 const *)(t0));
        fe_sub(t1,(i32 const *)(t1),(i32 const *)(t0));
        fe_sq(z2,(i32 const *)(z2));
        fe_mul121666(z3,(i32 const *)(t1));
        fe_sq(x3,(i32 const *)(x3));
        fe_add(t0,(i32 const *)(t0),(i32 const *)(z3));
        fe_mul(z3,(i32 const *)(x1),(i32 const *)(z2));
        fe_mul(z2,(i32 const *)(t1),(i32 const *)(t0));
      }
      pos --;
    }
  }
  fe_cswap(x2,x3,swap);
  fe_cswap(z2,z3,swap);
  fe_invert(z2,(i32 const *)(z2));
  fe_mul(x2,(i32 const *)(x2),(i32 const *)(z2));
  fe_tobytes(raw_shared_secret,(i32 const *)(x2));
  crypto_wipe((void *)(x1),sizeof(x1));
  crypto_wipe((void *)(e),sizeof(e));
  crypto_wipe((void *)(x2),sizeof(x2));
  crypto_wipe((void *)(z2),sizeof(z2));
  crypto_wipe((void *)(x3),sizeof(x3));
  crypto_wipe((void *)(z3),sizeof(z3));
  crypto_wipe((void *)(t0),sizeof(t0));
  crypto_wipe((void *)(t1),sizeof(t1));
  tmp_0 = zerocmp32((u8 const *)raw_shared_secret);
  __retres = -1 - tmp_0;
  return __retres;
}

static u8 const crypto_x25519_public_key_base_point[32] = {(u8)9};
void crypto_x25519_public_key(uint8_t public_key[32],
                              uint8_t const secret_key[32])
{
  crypto_x25519(public_key,secret_key,crypto_x25519_public_key_base_point);
  return;
}


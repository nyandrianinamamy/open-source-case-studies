static void fe_tobytes(u8 * /*[32]*/ s, i32 const * /*[10]*/ h)
{
  i32 t[10];
  {
    size_t i = (unsigned long)0;
    /*@ loop unroll 10; */
    while (i < (size_t)10) {
      t[i] = *(h + i);
      i += (size_t)1;
    }
  }
  i32 q = (19 * t[9] + (1 << 24)) >> 25;
  {
    size_t i_0 = (unsigned long)0;
    /*@ loop unroll 5; */
    while (i_0 < (size_t)5) {
      q += t[(size_t)2 * i_0];
      q >>= 26;
      q += t[(size_t)2 * i_0 + (size_t)1];
      q >>= 25;
      i_0 += (size_t)1;
    }
  }
  t[0] += 19 * q;
  i32 c0 = t[0] >> 26;
  t[1] += c0;
  t[0] -= c0 * (1 << 26);
  i32 c1 = t[1] >> 25;
  t[2] += c1;
  t[1] -= c1 * (1 << 25);
  i32 c2 = t[2] >> 26;
  t[3] += c2;
  t[2] -= c2 * (1 << 26);
  i32 c3 = t[3] >> 25;
  t[4] += c3;
  t[3] -= c3 * (1 << 25);
  i32 c4 = t[4] >> 26;
  t[5] += c4;
  t[4] -= c4 * (1 << 26);
  i32 c5 = t[5] >> 25;
  t[6] += c5;
  t[5] -= c5 * (1 << 25);
  i32 c6 = t[6] >> 26;
  t[7] += c6;
  t[6] -= c6 * (1 << 26);
  i32 c7 = t[7] >> 25;
  t[8] += c7;
  t[7] -= c7 * (1 << 25);
  i32 c8 = t[8] >> 26;
  t[9] += c8;
  t[8] -= c8 * (1 << 26);
  i32 c9 = t[9] >> 25;
  t[9] -= c9 * (1 << 25);
  store32_le(s + 0,((unsigned int)t[0] >> 0) | ((unsigned int)t[1] << 26));
  store32_le(s + 4,((unsigned int)t[1] >> 6) | ((unsigned int)t[2] << 19));
  store32_le(s + 8,((unsigned int)t[2] >> 13) | ((unsigned int)t[3] << 13));
  store32_le(s + 12,((unsigned int)t[3] >> 19) | ((unsigned int)t[4] << 6));
  store32_le(s + 16,((unsigned int)t[5] >> 0) | ((unsigned int)t[6] << 25));
  store32_le(s + 20,((unsigned int)t[6] >> 7) | ((unsigned int)t[7] << 19));
  store32_le(s + 24,((unsigned int)t[7] >> 13) | ((unsigned int)t[8] << 12));
  store32_le(s + 28,((unsigned int)t[8] >> 20) | ((unsigned int)t[9] << 6));
  crypto_wipe((void *)(t),sizeof(t));
  return;
}

static int fe_isnegative(i32 const * /*[10]*/ f)

static void edDSA(vector const *in, vector *out)
{
  u8 out2[64];
  int tmp;
  vector const *secret_k = in;
  vector const *public_k = in + 1;
  vector const *msg = in + 2;
  crypto_sign(out->buf,(uint8_t const *)secret_k->buf,
              (uint8_t const *)public_k->buf,(uint8_t const *)msg->buf,
              msg->size);
  crypto_sign(out2,(uint8_t const *)secret_k->buf,(uint8_t const *)0,
              (uint8_t const *)msg->buf,msg->size);
  tmp = memcmp((void const *)out->buf,(void const *)(out2),out->size);
  if (tmp) printf("FAILURE: reconstructing public key yields different signature\n"); /* printf_va_6 */
  return;
}

static void edDSA_pk(vector const *in, vector *out)
{
  crypto_sign_public_key(out->buf,(uint8_t const *)in->buf);
  return;
}

static void iterate_x25519(u8 k[32], u8 u[32])
{
  u8 tmp[32];
  crypto_x25519(tmp,(uint8_t const *)k,(uint8_t const *)u);
  memcpy((void *)u,(void const *)k,(size_t)32);
  memcpy((void *)k,(void const *)(tmp),(size_t)32);
  return;
}


    size_t i = (size_t)0;
    while (i < (size_t)32) {
      s[i] = (i64)((u64)*(c + i));
      i ++;
    }
  }
  {
    size_t i_0 = (size_t)32;
    while (i_0 < (size_t)64) {
      s[i_0] = (i64)0;
      i_0 ++;
    }
  }
  {

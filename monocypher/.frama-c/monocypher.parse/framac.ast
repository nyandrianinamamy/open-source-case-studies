  ctx->hash[5] = 0x9b05688c2b3e6c1f;
  ctx->hash[6] = (uint64_t)0x1f83d9abfb41bd6b;
  ctx->hash[7] = (uint64_t)0x5be0cd19137e2179;
  ctx->input_size[0] = (uint64_t)0;
  ctx->input_size[1] = (uint64_t)0;
  ctx->input_idx = (size_t)0;
  return;
}

void crypto_sha512_update(crypto_sha512_ctx *ctx, uint8_t const *message,
                          size_t message_size)
{
  unsigned long tmp;
  if (((~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1)) <= message_size) 
    tmp = (~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1);
  else tmp = message_size;
  size_t align = tmp;
  sha512_update(ctx,message,align);
  message += align;
  message_size -= align;
  {
    size_t i = (size_t)0;
    while (i < message_size / (size_t)128) {
      {
        size_t j = (size_t)0;
        while (j < (size_t)16) {
          ctx->input[j] = load64_be(message + j * (size_t)8);
          j ++;
        }
      }
      message += 128;
      ctx->input_idx += (size_t)128;
      sha512_end_block(ctx);
      i ++;
    }
  }
  message_size &= (unsigned long)127;
  sha512_update(ctx,message,message_size);
  return;
}

void crypto_sha512_final(crypto_sha512_ctx *ctx, uint8_t hash[64])
{
  sha512_incr(ctx->input_size,ctx->input_idx * (size_t)8);
  sha512_set_input(ctx,(u8)128);
  if (ctx->input_idx > (size_t)111) {
    sha512_compress(ctx);
    {
      size_t i = (size_t)0;
      while (i < (size_t)14) {
        ctx->input[i] = (uint64_t)0;
        i ++;
      }
    }
  }
  ctx->input[14] = ctx->input_size[0];
  ctx->input[15] = ctx->input_size[1];
  sha512_compress(ctx);
  {
    size_t i_0 = (size_t)0;
    while (i_0 < (size_t)8) {
      store64_be(hash + i_0 * (size_t)8,ctx->hash[i_0]);
      i_0 ++;
    }
  }
  crypto_wipe_0((void *)ctx,sizeof(*ctx));
  return;
}

void crypto_sha512(uint8_t *hash, uint8_t const *message, size_t message_size)
{
  crypto_sha512_ctx ctx;
  crypto_sha512_init(& ctx);
  crypto_sha512_update(& ctx,message,message_size);
  crypto_sha512_final(& ctx,hash);
  return;
}

static void store64_le_0(u8 out[8], u64 in)
{
  *(out + 0) = (u8)(in & (unsigned long)0xff);
  *(out + 1) = (u8)((in >> 8) & (unsigned long)0xff);
  *(out + 2) = (u8)((in >> 16) & (unsigned long)0xff);
  *(out + 3) = (u8)((in >> 24) & (unsigned long)0xff);
  *(out + 4) = (u8)((in >> 32) & (unsigned long)0xff);
  *(out + 5) = (u8)((in >> 40) & (unsigned long)0xff);
  *(out + 6) = (u8)((in >> 48) & (unsigned long)0xff);
  *(out + 7) = (u8)((in >> 56) & (unsigned long)0xff);
  return;
}

u64 load64_le(u8 const s[8])
{
  u64 __retres;
  __retres = (((((((u64)*(s + 0) | ((u64)*(s + 1) << 8)) | ((u64)*(s + 2) << 16)) | (
                 (u64)*(s + 3) << 24)) | ((u64)*(s + 4) << 32)) | ((u64)*(
                                                                   s + 5) << 40)) | (
              (u64)*(s + 6) << 48)) | ((u64)*(s + 7) << 56);
  return __retres;
}

u64 rand64(void);

static u64 rand64_x = (u64)12345;
u64 rand64(void)
{
  u64 __retres;
  rand64_x ^= rand64_x >> 12;
  rand64_x ^= rand64_x << 25;
  rand64_x ^= rand64_x >> 27;
  __retres = rand64_x * (u64)0x2545F4914F6CDD1D;
  return __retres;
}

void p_random(u8 *stream, size_t size)
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 480; */
  while (i < size) {
    {
      u64 tmp;
      tmp = rand64();
      *(stream + i) = (u8)tmp;
    }
    i ++;
  }
  return;
}


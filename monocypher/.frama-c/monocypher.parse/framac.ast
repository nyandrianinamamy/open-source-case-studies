  v0 += v5 + *(input + blake2b_compress_sigma[9][8]);
  v15 = rotr64(v15 ^ v0,(unsigned long)32);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(unsigned long)24);
  v0 += v5 + *(input + blake2b_compress_sigma[9][9]);
  v15 = rotr64(v15 ^ v0,(unsigned long)16);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(unsigned long)63);
  v1 += v6 + *(input + blake2b_compress_sigma[9][10]);
  v12 = rotr64(v12 ^ v1,(unsigned long)32);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(unsigned long)24);

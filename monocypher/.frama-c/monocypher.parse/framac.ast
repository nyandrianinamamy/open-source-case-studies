static void ge_cache(ge_cached *c, ge const *p)
{
  fe_add(c->Yp,p->Y,p->X);
  fe_sub(c->Ym,p->Y,p->X);
  fe_copy(c->Z,p->Z);
  fe_mul(c->T2,p->T,ge_cache_D2);
  return;
}

static void ge_add(ge *s, ge const *p, ge_cached const *q)
{
  fe a;
  fe b;
  fe_add(a,p->Y,p->X);
  fe_sub(b,p->Y,p->X);
  fe_mul(a,(i32 const *)(a),q->Yp);
  fe_mul(b,(i32 const *)(b),q->Ym);
  fe_add(s->Y,(i32 const *)(a),(i32 const *)(b));
  fe_sub(s->X,(i32 const *)(a),(i32 const *)(b));
  fe_add(s->Z,p->Z,p->Z);
  fe_mul(s->Z,(i32 const *)(s->Z),q->Z);
  fe_mul(s->T,p->T,q->T2);
  fe_add(a,(i32 const *)(s->Z),(i32 const *)(s->T));
  fe_sub(b,(i32 const *)(s->Z),(i32 const *)(s->T));
  fe_mul(s->T,(i32 const *)(s->X),(i32 const *)(s->Y));
  fe_mul(s->X,(i32 const *)(s->X),(i32 const *)(b));
  fe_mul(s->Y,(i32 const *)(s->Y),(i32 const *)(a));
  fe_mul(s->Z,(i32 const *)(a),(i32 const *)(b));
  return;
}

static void ge_sub(ge *s, ge const *p, ge_cached const *q)
{
  ge_cached neg;
  fe_copy(neg.Ym,q->Yp);
  fe_copy(neg.Yp,q->Ym);
  fe_copy(neg.Z,q->Z);
  fe_neg(neg.T2,q->T2);
  ge_add(s,p,(ge_cached const *)(& neg));
  return;
}

static void ge_madd(ge *s, ge const *p, i32 const yp[10], i32 const ym[10],
                    i32 const t2[10], i32 a[10], i32 b[10])
{
  fe_add(a,p->Y,p->X);
  fe_sub(b,p->Y,p->X);
  fe_mul(a,(i32 const *)a,yp);
  fe_mul(b,(i32 const *)b,ym);
  fe_add(s->Y,(i32 const *)a,(i32 const *)b);
  fe_sub(s->X,(i32 const *)a,(i32 const *)b);
  fe_add(s->Z,p->Z,p->Z);
  fe_mul(s->T,p->T,t2);
  fe_add(a,(i32 const *)(s->Z),(i32 const *)(s->T));
  fe_sub(b,(i32 const *)(s->Z),(i32 const *)(s->T));
  fe_mul(s->T,(i32 const *)(s->X),(i32 const *)(s->Y));
  fe_mul(s->X,(i32 const *)(s->X),(i32 const *)b);
  fe_mul(s->Y,(i32 const *)(s->Y),(i32 const *)a);
  fe_mul(s->Z,(i32 const *)a,(i32 const *)b);
  return;
}

static void ge_double(ge *s, ge const *p, ge *q)
{
  fe_sq(q->X,p->X);
  fe_sq(q->Y,p->Y);
  fe_sq2(q->Z,p->Z);
  fe_add(q->T,p->X,p->Y);
  fe_sq(s->T,(i32 const *)(q->T));
  fe_add(q->T,(i32 const *)(q->Y),(i32 const *)(q->X));
  fe_sub(q->Y,(i32 const *)(q->Y),(i32 const *)(q->X));
  fe_sub(q->X,(i32 const *)(s->T),(i32 const *)(q->T));
  fe_sub(q->Z,(i32 const *)(q->Z),(i32 const *)(q->Y));
  fe_mul(s->X,(i32 const *)(q->X),(i32 const *)(q->Z));
  fe_mul(s->Y,(i32 const *)(q->T),(i32 const *)(q->Y));
  fe_mul(s->Z,(i32 const *)(q->Y),(i32 const *)(q->Z));
  fe_mul(s->T,(i32 const *)(q->X),(i32 const *)(q->T));
  return;
}

static void slide(i8 adds[258], u8 const scalar[32])
{
  {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 256; */
    while (i < (size_t)256) {
      {
        int tmp;
        tmp = scalar_bit(scalar,(int)i);
        *(adds + i) = (i8)tmp;
      }
      i ++;
    }
  }
  {
    size_t i_0 = (size_t)256;
    /*@ loop \eva::unroll 2; */
    while (i_0 < (size_t)258) {
      *(adds + i_0) = (i8)0;
      i_0 ++;
    }
  }
  {
    size_t i_1 = (size_t)0;
    /*@ loop \eva::unroll 254; */
    while (i_1 < (size_t)254) {
      if ((int)*(adds + i_1) != 0) {
        {
          size_t j = (size_t)1;
          /*@ loop \eva::unroll 5; */
          while (j < (size_t)5) {
            *(adds + i_1) = (i8)((int)*(adds + i_1) | ((int)*(adds + (
                                                              i_1 + j)) << j));
            *(adds + (i_1 + j)) = (i8)0;
            j ++;
          }
        }
        if ((int)*(adds + i_1) > 16) {
          *(adds + i_1) = (i8)((int)*(adds + i_1) - 32);
          int j_0 = (int)(i_1 + (size_t)5);
          while ((int)*(adds + j_0) != 0) {
            *(adds + j_0) = (i8)0;
            j_0 ++;
          }
          *(adds + j_0) = (i8)1;
        }
      }
      i_1 ++;
    }
  }
  return;
}

static void ge_precompute(ge_cached lut[8], ge const *P1)
{
  ge P2;
  ge tmp;
  ge_double(& P2,P1,& tmp);
  ge_cache(lut + 0,P1);
  {
    size_t i = (size_t)0;
    while (i < (size_t)7) {
      ge_add(& tmp,(ge const *)(& P2),(ge_cached const *)(lut + i));
      ge_cache(lut + (i + (size_t)1),(ge const *)(& tmp));
      i ++;
    }
  }
  return;
}

static void ge_double_scalarmult_vartime(ge *sum, ge const *P, u8 p[32],
                                         u8 b[32]);

static fe const ge_double_scalarmult_vartime_X =
  {-14297830,
   -7645148,
   16144683,
   -16471763,
   27570974,
   -2696100,
   -26142465,
   8378389,
   20764389,
   8758491};
static fe const ge_double_scalarmult_vartime_Y =
  {-26843541,
   -6710886,
   13421773,
   -13421773,
   26843546,
   6710886,
   -13421773,
   13421773,
   -26843546,
   -6710886};
static void ge_double_scalarmult_vartime(ge *sum, ge const *P, u8 p[32],
                                         u8 b[32])
{
  ge B;
  ge_cached cP[8];
  ge_cached cB[8];
  i8 p_adds[258];
  i8 b_adds[258];
  fe_copy(B.X,ge_double_scalarmult_vartime_X);
  fe_copy(B.Y,ge_double_scalarmult_vartime_Y);
  fe_1(B.Z);
  fe_mul(B.T,ge_double_scalarmult_vartime_X,ge_double_scalarmult_vartime_Y);
  ge_precompute(cP,P);
  ge_precompute(cB,(ge const *)(& B));
  slide(p_adds,(u8 const *)p);
  slide(b_adds,(u8 const *)b);
  int i = 253;
  while (1) {
    if (i >= 0) 
      if ((int)p_adds[i] == 0) {
        if (! ((int)b_adds[i] == 0)) break;
      }
      else break;
    else break;
    i --;
  }
  ge_zero(sum);
  if ((int)p_adds[i] > 0) ge_add(sum,(ge const *)sum,
                                 (ge_cached const *)(& cP[(int)p_adds[i] / 2]));
  if ((int)p_adds[i] < 0) ge_sub(sum,(ge const *)sum,
                                 (ge_cached const *)(& cP[- ((int)p_adds[i]) / 2]));
  if ((int)b_adds[i] > 0) ge_add(sum,(ge const *)sum,
                                 (ge_cached const *)(& cB[(int)b_adds[i] / 2]));
  if ((int)b_adds[i] < 0) ge_sub(sum,(ge const *)sum,
                                 (ge_cached const *)(& cB[- ((int)b_adds[i]) / 2]));
  i --;
  while (i >= 0) {
    ge_double(sum,(ge const *)sum,& B);
    if ((int)p_adds[i] > 0) ge_add(sum,(ge const *)sum,
                                   (ge_cached const *)(& cP[(int)p_adds[i] / 2]));
    if ((int)p_adds[i] < 0) ge_sub(sum,(ge const *)sum,
                                   (ge_cached const *)(& cP[- ((int)p_adds[i]) / 2]));
    if ((int)b_adds[i] > 0) ge_add(sum,(ge const *)sum,
                                   (ge_cached const *)(& cB[(int)b_adds[i] / 2]));
    if ((int)b_adds[i] < 0) ge_sub(sum,(ge const *)sum,
                                   (ge_cached const *)(& cB[- ((int)b_adds[i]) / 2]));
    i --;
  }
  return;
}


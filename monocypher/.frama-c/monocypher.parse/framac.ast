static void *alloc(size_t size)
{
  void *__retres;
  if (size == (size_t)0) {
    __retres = (void *)0;
    goto return_label;
  }
  void *buf = malloc(size);
  if (buf == (void *)0) {
    fprintf(__fc_stderr,"Allocation failed: 0x%zx bytes\n",size); /* fprintf_va_1 */
    exit(1);
  }
  __retres = buf;
  return_label: return __retres;
}

int zerocmp(u8 const *p, size_t n)
{
  int __retres;
  {
    size_t i = (unsigned long)0;
    /*@ loop unroll 32; */
    while (i < n) {
      if ((int)*(p + i) != 0) {
        __retres = -1;
        goto return_label;
      }
      i += (size_t)1;
    }
  }
  __retres = 0;
  return_label: return __retres;
}


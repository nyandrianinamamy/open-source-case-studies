static int test(void (*f)(vector const *, vector *), char const *name,
                size_t nb_inputs, size_t nb_vectors, u8 **vectors,
                size_t *sizes)
{
  vector *in;
  char const *tmp_2;
  int status = 0;
  int nb_tests = 0;
  size_t idx = (size_t)0;
  in = (vector *)alloc(nb_vectors * sizeof(vector));
  while (idx < nb_vectors) {
    vector out;
    vector expected;
    size_t out_size = *(sizes + (idx + nb_inputs));
    out.buf = (u8 *)alloc(out_size);
    out.size = out_size;
    {
      size_t i = (size_t)0;
      /*@ loop \eva::unroll 6; */
      while (i < nb_inputs) {
        (in + i)->buf = *(vectors + (idx + i));
        (in + i)->size = *(sizes + (idx + i));
        i ++;
      }
    }
    (*f)((vector const *)in,& out);
    expected.buf = *(vectors + (idx + nb_inputs));
    expected.size = *(sizes + (idx + nb_inputs));
    status = (int)((unsigned long)status | (out.size - expected.size));
    if (out.size != (size_t)0) {
      int tmp_1;
      tmp_1 = memcmp((void const *)out.buf,(void const *)expected.buf,
                     out.size);
      status |= tmp_1;
    }
    free((void *)out.buf);
    idx += nb_inputs + (size_t)1;
    nb_tests ++;
  }
  free((void *)in);
  ;
  ;
  if (status != 0) tmp_2 = "FAILED"; else tmp_2 = "OK";
  printf("%s %4d tests: %s\n",(char *)tmp_2,nb_tests,(char *)name); /* printf_va_3 */
  return status;
}

static void chacha20(vector const *in, vector *out)
{
  crypto_chacha_ctx ctx;
  vector const *key = in;
  vector const *nonce = in + 1;
  vector const *plain = in + 2;
  u64 ctr = load64_le((u8 const *)(in + 3)->buf);
  crypto_chacha20_init(& ctx,(uint8_t const *)key->buf,
                       (uint8_t const *)nonce->buf);
  crypto_chacha20_set_ctr(& ctx,ctr);
  crypto_chacha20_encrypt(& ctx,out->buf,(uint8_t const *)plain->buf,
                          plain->size);
  return;
}

static void hchacha20(vector const *in, vector *out)
{
  vector const *key = in;
  vector const *nonce = in + 1;
  crypto_chacha20_H(out->buf,(uint8_t const *)key->buf,
                    (uint8_t const *)nonce->buf);
  return;
}

static void xchacha20(vector const *in, vector *out)
{
  crypto_chacha_ctx ctx;
  vector const *key = in;
  vector const *nonce = in + 1;
  vector const *plain = in + 2;
  u64 ctr = load64_le((u8 const *)(in + 3)->buf);
  crypto_chacha20_x_init(& ctx,(uint8_t const *)key->buf,
                         (uint8_t const *)nonce->buf);
  crypto_chacha20_set_ctr(& ctx,ctr);
  crypto_chacha20_encrypt(& ctx,out->buf,(uint8_t const *)plain->buf,
                          plain->size);
  return;
}

static void poly1305(vector const *in, vector *out)
{
  vector const *key = in;
  vector const *msg = in + 1;
  crypto_poly1305(out->buf,(uint8_t const *)msg->buf,msg->size,
                  (uint8_t const *)key->buf);
  return;
}

static void aead_ietf(vector const *in, vector *out)
{
  vector const *key = in;
  vector const *nonce = in + 1;
  vector const *ad = in + 2;
  vector const *text = in + 3;
  crypto_lock_aead(out->buf,out->buf + 16,(uint8_t const *)key->buf,
                   (uint8_t const *)nonce->buf,(uint8_t const *)ad->buf,
                   ad->size,(uint8_t const *)text->buf,text->size);
  return;
}

static void blake2b(vector const *in, vector *out)
{
  vector const *msg = in;
  vector const *key = in + 1;
  crypto_blake2b_general(out->buf,out->size,(uint8_t const *)key->buf,
                         key->size,(uint8_t const *)msg->buf,msg->size);
  return;
}

static void sha512(vector const *in, vector *out)
{
  crypto_sha512(out->buf,(uint8_t const *)in->buf,in->size);
  return;
}

static void argon2i(vector const *in, vector *out)
{
  u64 nb_blocks = load64_le((u8 const *)(in + 0)->buf);
  u64 nb_iterations = load64_le((u8 const *)(in + 1)->buf);
  vector const *password = in + 2;
  vector const *salt = in + 3;
  vector const *key = in + 4;
  vector const *ad = in + 5;
  void *work_area = alloc(nb_blocks * (u64)1024);
  crypto_argon2i_general(out->buf,(uint32_t)out->size,work_area,
                         (uint32_t)nb_blocks,(uint32_t)nb_iterations,
                         (uint8_t const *)password->buf,
                         (uint32_t)password->size,(uint8_t const *)salt->buf,
                         (uint32_t)salt->size,(uint8_t const *)key->buf,
                         (uint32_t)key->size,(uint8_t const *)ad->buf,
                         (uint32_t)ad->size);
  free(work_area);
  return;
}


static void x25519(vector const *in, vector *out)
{
  vector const *scalar = in;
  vector const *point = in + 1;
  int report =
    crypto_x25519(out->buf,(uint8_t const *)scalar->buf,
                  (uint8_t const *)point->buf);
  int not_zero = zerocmp((u8 const *)out->buf,out->size);
  if (not_zero) 
    if (report) printf("FAILURE: x25519 false all_zero report\n"); /* printf_va_4 */
  if (! not_zero) 
    if (! report) printf("FAILURE: x25519 failed to report zero\n"); /* printf_va_5 */
  return;
}

static void x25519_pk(vector const *in, vector *out)
{
  crypto_x25519_public_key(out->buf,(uint8_t const *)in->buf);
  return;
}

static void key_exchange(vector const *in, vector *out)
{
  vector const *secret_key = in;
  vector const *public_key = in + 1;
  crypto_key_exchange(out->buf,(uint8_t const *)secret_key->buf,
                      (uint8_t const *)public_key->buf);
  return;
}


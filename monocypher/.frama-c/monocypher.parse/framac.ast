}

static int scalar_bit(u8 const * /*[32]*/ s, int i)
{
  int __retres;
  __retres = ((int)*(s + (i >> 3)) >> (i & 7)) & 1;
  return __retres;
}

int crypto_x25519(uint8_t * /*[32]*/ raw_shared_secret,
                  uint8_t const * /*[32]*/ your_secret_key,
                  uint8_t const * /*[32]*/ their_public_key)
{
  int __retres;
  fe x1;
  u8 e[32];
  fe x2;
  fe z2;
  fe x3;
  fe z3;
  fe t0;
  fe t1;
  int tmp_0;
  fe_frombytes(x1,their_public_key);
  {
    size_t i = (unsigned long)0;
    while (i < (size_t)32) {
      e[i] = *(your_secret_key + i);
      i += (size_t)1;
    }
  }
  trim_scalar(e);
  fe_1(x2);
  fe_0(z2);
  fe_copy(x3,(i32 const *)(x1));
  fe_1(z3);
  int swap = 0;
  {
    int pos = 254;
    while (pos >= 0) {
      {
        int b = scalar_bit((u8 const *)(e),pos);
        swap ^= b;
        fe_cswap(x2,x3,swap);
        fe_cswap(z2,z3,swap);
        swap = b;
        fe_sub(t0,(i32 const *)(x3),(i32 const *)(z3));
        fe_sub(t1,(i32 const *)(x2),(i32 const *)(z2));
        fe_add(x2,(i32 const *)(x2),(i32 const *)(z2));
        fe_add(z2,(i32 const *)(x3),(i32 const *)(z3));
        fe_mul(z3,(i32 const *)(t0),(i32 const *)(x2));
        fe_mul(z2,(i32 const *)(z2),(i32 const *)(t1));
        fe_sq(t0,(i32 const *)(t1));
        fe_sq(t1,(i32 const *)(x2));
        fe_add(x3,(i32 const *)(z3),(i32 const *)(z2));
        fe_sub(z2,(i32 const *)(z3),(i32 const *)(z2));
        fe_mul(x2,(i32 const *)(t1),(i32 const *)(t0));
        fe_sub(t1,(i32 const *)(t1),(i32 const *)(t0));
        fe_sq(z2,(i32 const *)(z2));
        fe_mul121666(z3,(i32 const *)(t1));
        fe_sq(x3,(i32 const *)(x3));

                                                                 x + i)) * L[
                                                           j - (size_t)(
                                                           i - (unsigned int)32)]));
            carry = (*(x + j) + (i64)128) >> 8;
            *(x + j) -= carry * (i64)(1 << 8);
            j ++;
          }
        }
        *(x + (i - (unsigned int)12)) += carry;
        *(x + i) = (i64)0;
      }
      i --;
    }
  }
  i64 carry_0 = (i64)0;
  {
    size_t i_0 = (size_t)0;
    /*@ loop \eva::unroll 32; */
    while (i_0 < (size_t)32) {
      *(x + i_0) = (i64)((u64)*(x + i_0) + ((u64)carry_0 - (u64)(*(x + 31) >> 4) * L[i_0]));
      carry_0 = *(x + i_0) >> 8;
      *(x + i_0) &= (long)255;
      i_0 ++;
    }

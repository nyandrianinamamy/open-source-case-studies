  size_t i = (unsigned long)0;
  /*@ loop unroll 10; */
  while (i < (size_t)10) {
    {
      i32 x = (*(f + i) ^ *(g + i)) & - b;
      *(f + i) ^= x;
    }
    i += (size_t)1;
  }
  return;
}


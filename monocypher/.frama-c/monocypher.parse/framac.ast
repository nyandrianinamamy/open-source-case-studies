  v3 += v7 + *(input + blake2b_compress_sigma[9][7]);
  v15 = rotr64(v15 ^ v3,(u64)16);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(u64)63);
  v0 += v5 + *(input + blake2b_compress_sigma[9][8]);
  v15 = rotr64(v15 ^ v0,(u64)32);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)24);
  v0 += v5 + *(input + blake2b_compress_sigma[9][9]);
  v15 = rotr64(v15 ^ v0,(u64)16);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)63);
  v1 += v6 + *(input + blake2b_compress_sigma[9][10]);
  v12 = rotr64(v12 ^ v1,(u64)32);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)24);
  v1 += v6 + *(input + blake2b_compress_sigma[9][11]);
  v12 = rotr64(v12 ^ v1,(u64)16);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)63);
  v2 += v7 + *(input + blake2b_compress_sigma[9][12]);
  v13 = rotr64(v13 ^ v2,(u64)32);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)24);
  v2 += v7 + *(input + blake2b_compress_sigma[9][13]);
  v13 = rotr64(v13 ^ v2,(u64)16);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)63);
  v3 += v4 + *(input + blake2b_compress_sigma[9][14]);
  v14 = rotr64(v14 ^ v3,(u64)32);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)24);
  v3 += v4 + *(input + blake2b_compress_sigma[9][15]);
  v14 = rotr64(v14 ^ v3,(u64)16);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)63);
  v0 += v4 + *(input + blake2b_compress_sigma[0][0]);
  v12 = rotr64(v12 ^ v0,(u64)32);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(u64)24);
  v0 += v4 + *(input + blake2b_compress_sigma[0][1]);
  v12 = rotr64(v12 ^ v0,(u64)16);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(u64)63);
  v1 += v5 + *(input + blake2b_compress_sigma[0][2]);
  v13 = rotr64(v13 ^ v1,(u64)32);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(u64)24);
  v1 += v5 + *(input + blake2b_compress_sigma[0][3]);
  v13 = rotr64(v13 ^ v1,(u64)16);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(u64)63);
  v2 += v6 + *(input + blake2b_compress_sigma[0][4]);
  v14 = rotr64(v14 ^ v2,(u64)32);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(u64)24);
  v2 += v6 + *(input + blake2b_compress_sigma[0][5]);
  v14 = rotr64(v14 ^ v2,(u64)16);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(u64)63);
  v3 += v7 + *(input + blake2b_compress_sigma[0][6]);
  v15 = rotr64(v15 ^ v3,(u64)32);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(u64)24);
  v3 += v7 + *(input + blake2b_compress_sigma[0][7]);
  v15 = rotr64(v15 ^ v3,(u64)16);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(u64)63);
  v0 += v5 + *(input + blake2b_compress_sigma[0][8]);
  v15 = rotr64(v15 ^ v0,(u64)32);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)24);
  v0 += v5 + *(input + blake2b_compress_sigma[0][9]);
  v15 = rotr64(v15 ^ v0,(u64)16);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)63);
  v1 += v6 + *(input + blake2b_compress_sigma[0][10]);
  v12 = rotr64(v12 ^ v1,(u64)32);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)24);
  v1 += v6 + *(input + blake2b_compress_sigma[0][11]);
  v12 = rotr64(v12 ^ v1,(u64)16);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)63);
  v2 += v7 + *(input + blake2b_compress_sigma[0][12]);
  v13 = rotr64(v13 ^ v2,(u64)32);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)24);
  v2 += v7 + *(input + blake2b_compress_sigma[0][13]);
  v13 = rotr64(v13 ^ v2,(u64)16);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)63);
  v3 += v4 + *(input + blake2b_compress_sigma[0][14]);
  v14 = rotr64(v14 ^ v3,(u64)32);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)24);
  v3 += v4 + *(input + blake2b_compress_sigma[0][15]);
  v14 = rotr64(v14 ^ v3,(u64)16);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)63);
  v0 += v4 + *(input + blake2b_compress_sigma[1][0]);
  v12 = rotr64(v12 ^ v0,(u64)32);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(u64)24);
  v0 += v4 + *(input + blake2b_compress_sigma[1][1]);
  v12 = rotr64(v12 ^ v0,(u64)16);
  v8 += v12;
  v4 = rotr64(v4 ^ v8,(u64)63);
  v1 += v5 + *(input + blake2b_compress_sigma[1][2]);
  v13 = rotr64(v13 ^ v1,(u64)32);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(u64)24);
  v1 += v5 + *(input + blake2b_compress_sigma[1][3]);
  v13 = rotr64(v13 ^ v1,(u64)16);
  v9 += v13;
  v5 = rotr64(v5 ^ v9,(u64)63);
  v2 += v6 + *(input + blake2b_compress_sigma[1][4]);
  v14 = rotr64(v14 ^ v2,(u64)32);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(u64)24);
  v2 += v6 + *(input + blake2b_compress_sigma[1][5]);
  v14 = rotr64(v14 ^ v2,(u64)16);
  v10 += v14;
  v6 = rotr64(v6 ^ v10,(u64)63);
  v3 += v7 + *(input + blake2b_compress_sigma[1][6]);
  v15 = rotr64(v15 ^ v3,(u64)32);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(u64)24);
  v3 += v7 + *(input + blake2b_compress_sigma[1][7]);
  v15 = rotr64(v15 ^ v3,(u64)16);
  v11 += v15;
  v7 = rotr64(v7 ^ v11,(u64)63);
  v0 += v5 + *(input + blake2b_compress_sigma[1][8]);
  v15 = rotr64(v15 ^ v0,(u64)32);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)24);
  v0 += v5 + *(input + blake2b_compress_sigma[1][9]);
  v15 = rotr64(v15 ^ v0,(u64)16);
  v10 += v15;
  v5 = rotr64(v5 ^ v10,(u64)63);
  v1 += v6 + *(input + blake2b_compress_sigma[1][10]);
  v12 = rotr64(v12 ^ v1,(u64)32);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)24);
  v1 += v6 + *(input + blake2b_compress_sigma[1][11]);
  v12 = rotr64(v12 ^ v1,(u64)16);
  v11 += v12;
  v6 = rotr64(v6 ^ v11,(u64)63);
  v2 += v7 + *(input + blake2b_compress_sigma[1][12]);
  v13 = rotr64(v13 ^ v2,(u64)32);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)24);
  v2 += v7 + *(input + blake2b_compress_sigma[1][13]);
  v13 = rotr64(v13 ^ v2,(u64)16);
  v8 += v13;
  v7 = rotr64(v7 ^ v8,(u64)63);
  v3 += v4 + *(input + blake2b_compress_sigma[1][14]);
  v14 = rotr64(v14 ^ v3,(u64)32);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)24);
  v3 += v4 + *(input + blake2b_compress_sigma[1][15]);
  v14 = rotr64(v14 ^ v3,(u64)16);
  v9 += v14;
  v4 = rotr64(v4 ^ v9,(u64)63);
  ctx->hash[0] ^= v0 ^ v8;
  ctx->hash[1] ^= v1 ^ v9;
  ctx->hash[2] ^= v2 ^ v10;
  ctx->hash[3] ^= v3 ^ v11;
  ctx->hash[4] ^= v4 ^ v12;
  ctx->hash[5] ^= v5 ^ v13;
  ctx->hash[6] ^= v6 ^ v14;
  ctx->hash[7] ^= v7 ^ v15;
  return;
}

static void blake2b_set_input(crypto_blake2b_ctx *ctx, u8 input,
                              size_t index_0)
{
  if (index_0 == (size_t)0) {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 16; */
    while (i < (size_t)16) {
      ctx->input[i] = (uint64_t)0;
      i ++;
    }
  }
  size_t word = index_0 >> 3;
  size_t byte = index_0 & (unsigned long)7;
  ctx->input[word] |= (u64)input << (byte << 3);
  return;
}

static void blake2b_end_block(crypto_blake2b_ctx *ctx)
{
  if (ctx->input_idx == (size_t)128) {
    blake2b_incr(ctx);
    blake2b_compress(ctx,0);
    ctx->input_idx = (size_t)0;
  }
  return;
}

static void blake2b_update(crypto_blake2b_ctx *ctx, u8 const *message,
                           size_t message_size)
{
  size_t i = (size_t)0;
  while (i < message_size) {
    blake2b_end_block(ctx);
    blake2b_set_input(ctx,*(message + i),ctx->input_idx);
    (ctx->input_idx) ++;
    i ++;
  }
  return;
}

void crypto_blake2b_general_init(crypto_blake2b_ctx *ctx, size_t hash_size,
                                 uint8_t const *key, size_t key_size)
{
  {
    size_t i = (size_t)0;
    /*@ loop \eva::unroll 8; */
    while (i < (size_t)8) {
      ctx->hash[i] = iv[i];
      i ++;
    }
  }
  ctx->hash[0] ^= ((unsigned long)0x01010000 ^ (key_size << 8)) ^ hash_size;
  ctx->input_offset[0] = (uint64_t)0;
  ctx->input_offset[1] = (uint64_t)0;
  ctx->hash_size = hash_size;
  ctx->input_idx = (size_t)0;
  if (key_size > (size_t)0) {
    crypto_blake2b_update(ctx,key,key_size);
    crypto_blake2b_update(ctx,zero,(size_t)128 - key_size);
  }
  return;
}

void crypto_blake2b_init(crypto_blake2b_ctx *ctx)
{
  crypto_blake2b_general_init(ctx,(size_t)64,(uint8_t const *)0,(size_t)0);
  return;
}

void crypto_blake2b_update(crypto_blake2b_ctx *ctx, uint8_t const *message,
                           size_t message_size)
{
  unsigned long tmp;
  if (((~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1)) <= message_size) 
    tmp = (~ ctx->input_idx + (size_t)1) & (unsigned long)(128 - 1);
  else tmp = message_size;
  size_t align = tmp;
  blake2b_update(ctx,message,align);
  message += align;
  message_size -= align;
  {
    size_t i = (size_t)0;
    while (i < message_size >> 7) {
      blake2b_end_block(ctx);
      {
        size_t j = (size_t)0;
        /*@ loop \eva::unroll 16; */
        while (j < (size_t)16) {
          ctx->input[j] = load64_le_0(message + j * (size_t)8);
          j ++;
        }
      }
      message += 128;
      ctx->input_idx = (size_t)128;
      i ++;
    }
  }
  message_size &= (unsigned long)127;
  blake2b_update(ctx,message,message_size);
  return;
}

void crypto_blake2b_final(crypto_blake2b_ctx *ctx, uint8_t *hash)
{
  {
    size_t i = ctx->input_idx;
    while (i < (size_t)128) {
      blake2b_set_input(ctx,(u8)0,i);
      i ++;
    }
  }
  blake2b_incr(ctx);
  blake2b_compress(ctx,-1);
  size_t nb_words = ctx->hash_size >> 3;
  {
    size_t i_0 = (size_t)0;
    while (i_0 < nb_words) {
      store64_le(hash + i_0 * (size_t)8,ctx->hash[i_0]);
      i_0 ++;
    }
  }
  {
    size_t i_1 = nb_words * (size_t)8;
    while (i_1 < ctx->hash_size) {
      *(hash + i_1) = (uint8_t)((ctx->hash[i_1 >> 3] >> (unsigned long)8 * (
                                                        i_1 & (unsigned long)7)) & (unsigned long)0xff);
      i_1 ++;
    }
  }
  crypto_wipe((void *)ctx,sizeof(*ctx));
  return;
}

void crypto_blake2b_general(uint8_t *hash, size_t hash_size,
                            uint8_t const *key, size_t key_size,
                            uint8_t const *message, size_t message_size)
{
  crypto_blake2b_ctx ctx;
  crypto_blake2b_general_init(& ctx,hash_size,key,key_size);
  crypto_blake2b_update(& ctx,message,message_size);
  crypto_blake2b_final(& ctx,hash);
  return;
}

void crypto_blake2b(uint8_t hash[64], uint8_t const *message,
                    size_t message_size)
{
  crypto_blake2b_general(hash,(size_t)64,(uint8_t const *)0,(size_t)0,
                         message,message_size);
  return;
}

static void wipe_block(block *b)
{
  u64 volatile *a = (u64 volatile *)(b->a);
  {
    size_t i = (size_t)0;
    while (i < (size_t)128) {
      *(a + i) = (u64)0;
      i ++;
    }
  }
  return;
}

static void blake_update_32(crypto_blake2b_ctx *ctx, u32 input)
{
  u8 buf[4];
  store32_le(buf,input);
  crypto_blake2b_update(ctx,(uint8_t const *)(buf),(size_t)4);
  crypto_wipe((void *)(buf),sizeof(buf));
  return;
}

static void load_block(block *b, u8 const bytes[1024])
{
  size_t i = (size_t)0;
  while (i < (size_t)128) {
    b->a[i] = load64_le_0(bytes + i * (size_t)8);
    i ++;
  }
  return;
}

static void store_block(u8 bytes[1024], block const *b)
{
  size_t i = (size_t)0;
  while (i < (size_t)128) {
    store64_le(bytes + i * (size_t)8,b->a[i]);
    i ++;
  }
  return;
}

static void copy_block(block *o, block const *in)
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 128; */
  while (i < (size_t)128) {
    o->a[i] = in->a[i];
    i ++;
  }
  return;
}

static void xor_block(block *o, block const *in)
{
  size_t i = (size_t)0;
  /*@ loop \eva::unroll 128; */
  while (i < (size_t)128) {
    o->a[i] ^= in->a[i];
    i ++;
  }
  return;
}

static void extended_hash(u8 *digest, u32 digest_size, u8 const *input,
                          u32 input_size)
{
  crypto_blake2b_ctx ctx;
  u32 tmp;
  if (digest_size <= (u32)64) tmp = digest_size; else tmp = (u32)64;
  crypto_blake2b_general_init(& ctx,(size_t)tmp,(uint8_t const *)0,(size_t)0);
  blake_update_32(& ctx,digest_size);
  crypto_blake2b_update(& ctx,input,(size_t)input_size);
  crypto_blake2b_final(& ctx,digest);
  if (digest_size > (u32)64) {
    u32 r = (u32)((((u64)digest_size + (u64)31) >> 5) - (u64)2);
    u32 i = (u32)1;
    u32 in = (u32)0;
    u32 out = (u32)32;
    while (i < r) {
      crypto_blake2b(digest + out,(uint8_t const *)(digest + in),(size_t)64);
      i += (u32)1;
      in += (u32)32;
      out += (u32)32;
    }
    crypto_blake2b_general(digest + out,(size_t)(digest_size - (u32)32 * r),
                           (uint8_t const *)0,(size_t)0,
                           (uint8_t const *)(digest + in),(size_t)64);
  }
  return;
}

static void g_rounds(block *work_block)
{
  {
    int i = 0;
    /*@ loop \eva::unroll 8; */
    while (i < 128) {
      work_block->a[i] += work_block->a[i + 4] + ((unsigned long)2 * (
                                                  work_block->a[i] & (unsigned long)0xffffffff)) * (
                                                 work_block->a[i + 4] & (unsigned long)0xffffffff);
      work_block->a[i + 12] ^= work_block->a[i];
      work_block->a[i + 12] = rotr64(work_block->a[i + 12],(u64)32);
      work_block->a[i + 8] += work_block->a[i + 12] + ((unsigned long)2 * (
                                                       work_block->a[
                                                       i + 8] & (unsigned long)0xffffffff)) * (
                                                      work_block->a[i + 12] & (unsigned long)0xffffffff);
      work_block->a[i + 4] ^= work_block->a[i + 8];
      work_block->a[i + 4] = rotr64(work_block->a[i + 4],(u64)24);
      work_block->a[i] += work_block->a[i + 4] + ((unsigned long)2 * (
                                                  work_block->a[i] & (unsigned long)0xffffffff)) * (
                                                 work_block->a[i + 4] & (unsigned long)0xffffffff);
      work_block->a[i + 12] ^= work_block->a[i];
      work_block->a[i + 12] = rotr64(work_block->a[i + 12],(u64)16);
      work_block->a[i + 8] += work_block->a[i + 12] + ((unsigned long)2 * (
                                                       work_block->a[
                                                       i + 8] & (unsigned long)0xffffffff)) * (
                                                      work_block->a[i + 12] & (unsigned long)0xffffffff);
      work_block->a[i + 4] ^= work_block->a[i + 8];
      work_block->a[i + 4] = rotr64(work_block->a[i + 4],(u64)63);
      work_block->a[i + 1] += work_block->a[i + 5] + ((unsigned long)2 * (
                                                      work_block->a[i + 1] & (unsigned long)0xffffffff)) * (
                                                     work_block->a[i + 5] & (unsigned long)0xffffffff);
      work_block->a[i + 13] ^= work_block->a[i + 1];
      work_block->a[i + 13] = rotr64(work_block->a[i + 13],(u64)32);
      work_block->a[i + 9] += work_block->a[i + 13] + ((unsigned long)2 * (
                                                       work_block->a[
                                                       i + 9] & (unsigned long)0xffffffff)) * (
                                                      work_block->a[i + 13] & (unsigned long)0xffffffff);
      work_block->a[i + 5] ^= work_block->a[i + 9];
      work_block->a[i + 5] = rotr64(work_block->a[i + 5],(u64)24);
      work_block->a[i + 1] += work_block->a[i + 5] + ((unsigned long)2 * (
                                                      work_block->a[i + 1] & (unsigned long)0xffffffff)) * (
                                                     work_block->a[i + 5] & (unsigned long)0xffffffff);
      work_block->a[i + 13] ^= work_block->a[i + 1];
      work_block->a[i + 13] = rotr64(work_block->a[i + 13],(u64)16);
      work_block->a[i + 9] += work_block->a[i + 13] + ((unsigned long)2 * (
                                                       work_block->a[
                                                       i + 9] & (unsigned long)0xffffffff)) * (
                                                      work_block->a[i + 13] & (unsigned long)0xffffffff);
      work_block->a[i + 5] ^= work_block->a[i + 9];
      work_block->a[i + 5] = rotr64(work_block->a[i + 5],(u64)63);
      work_block->a[i + 2] += work_block->a[i + 6] + ((unsigned long)2 * (
                                                      work_block->a[i + 2] & (unsigned long)0xffffffff)) * (
                                                     work_block->a[i + 6] & (unsigned long)0xffffffff);
      work_block->a[i + 14] ^= work_block->a[i + 2];
      work_block->a[i + 14] = rotr64(work_block->a[i + 14],(u64)32);
      work_block->a[i + 10] += work_block->a[i + 14] + ((unsigned long)2 * (
                                                        work_block->a[
                                                        i + 10] & (unsigned long)0xffffffff)) * (
                                                       work_block->a[
                                                       i + 14] & (unsigned long)0xffffffff);
      work_block->a[i + 6] ^= work_block->a[i + 10];
      work_block->a[i + 6] = rotr64(work_block->a[i + 6],(u64)24);
      work_block->a[i + 2] += work_block->a[i + 6] + ((unsigned long)2 * (
                                                      work_block->a[i + 2] & (unsigned long)0xffffffff)) * (
                                                     work_block->a[i + 6] & (unsigned long)0xffffffff);
      work_block->a[i + 14] ^= work_block->a[i + 2];
      work_block->a[i + 14] = rotr64(work_block->a[i + 14],(u64)16);
      work_block->a[i + 10] += work_block->a[i + 14] + ((unsigned long)2 * (
                                                        work_block->a[
                                                        i + 10] & (unsigned long)0xffffffff)) * (
                                                       work_block->a[
                                                       i + 14] & (unsigned long)0xffffffff);
      work_block->a[i + 6] ^= work_block->a[i + 10];
      work_block->a[i + 6] = rotr64(work_block->a[i + 6],(u64)63);
      work_block->a[i + 3] += work_block->a[i + 7] + ((unsigned long)2 * (
                                                      work_block->a[i + 3] & (unsigned long)0xffffffff)) * (
                                                     work_block->a[i + 7] & (unsigned long)0xffffffff);
      work_block->a[i + 15] ^= work_block->a[i + 3];
      work_block->a[i + 15] = rotr64(work_block->a[i + 15],(u64)32);
      work_block->a[i + 11] += work_block->a[i + 15] + ((unsigned long)2 * (
                                                        work_block->a[
                                                        i + 11] & (unsigned long)0xffffffff)) * (
                                                       work_block->a[
                                                       i + 15] & (unsigned long)0xffffffff);
      work_block->a[i + 7] ^= work_block->a[i + 11];

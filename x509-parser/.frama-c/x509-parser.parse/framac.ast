  u16 data_len = (unsigned short)0;
  u16 hdr_len = (unsigned short)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -1009;
              goto out;
            }
    }
  ret = parse_explicit_id_len(buf,len,(unsigned int)0,CLASS_UNIVERSAL,
                              (unsigned int)ASN1_TYPE_INTEGER,& hdr_len,
                              & data_len);
  if (ret) goto out;
  buf += (int)hdr_len;
  if ((int)data_len != 1) {
    ret = -1029;
    goto out;
  }
  if ((int)*(buf + 0) != 0x02) {
    ret = -1035;
    goto out;
  }
  *eaten = (unsigned short)((int)hdr_len + (int)data_len);
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..));
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_CertificateSerialNumber(u8 const *buf, u16 len,
                                         tag_class exp_class, u32 exp_type,
                                         u16 *eaten)
{
  int ret;
  u16 parsed = (unsigned short)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -1077;
              goto out;
            }
    }
  ret = parse_integer(buf,len,exp_class,exp_type,& parsed);
  if (ret) goto out;
  if ((int)parsed == 3) 
    if ((int)*(buf + 2) == 0) {
      ret = -1101;
      goto out;
    }
  if ((int)parsed > 22) {
    ret = -1113;
    goto out;
  }
  if ((int)*(buf + 2) & 0x80) {
    ret = -1120;
    goto out;
  }
  *eaten = parsed;
  ret = 0;
  out: ;
  return ret;
}


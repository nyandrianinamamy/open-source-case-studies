                     (unsigned int)ASN1_TYPE_SEQUENCE,& name_hdr_len,
                     & name_data_len);
  if (ret) goto out;
  buf += (int)name_hdr_len;
  remain = name_data_len;
  /*@ loop invariant \valid_read(buf + (0 .. remain - 1));
      loop assigns ret, buf, remain;

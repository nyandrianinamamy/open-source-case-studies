  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \valid(ctx);
    requires \separated(eaten, ctx, buf + (..));

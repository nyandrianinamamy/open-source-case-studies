 */
static int parse_x509_Extensions(u8 const *buf, u16 len, u16 *eaten,
                                 cert_parsing_ctx *ctx)
{
  _ext_oid const *parsed_oid_list[sizeof(known_ext_oids) / sizeof(known_ext_oids[0])];
  int ret;
  u16 i;
  u16 data_len = (unsigned short)0;
  u16 hdr_len = (unsigned short)0;
  u16 remain = (unsigned short)0;
  u16 saved_len = (unsigned short)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -8366;
              goto out;
            }
    }
  ret = parse_explicit_id_len(buf,len,(unsigned int)3,CLASS_UNIVERSAL,
                              (unsigned int)ASN1_TYPE_SEQUENCE,& hdr_len,
                              & data_len);
  if (ret) goto out;
  remain = data_len;
  buf += (int)hdr_len;
  /*@ assert \valid_read(buf + (0 .. remain - 1)); */ ;
  saved_len = (unsigned short)((int)hdr_len + (int)data_len);
  /*@ assert saved_len ≤ len; */ ;
  /*@ assert data_len ≤ saved_len; */ ;
  if ((int)data_len == 0) {
    ret = -8393;
    goto out;
  }
  i = (unsigned short)0;
  /*@ loop invariant
        i < sizeof(known_ext_oids) / sizeof(known_ext_oids[0]) ⇒
        \valid(&parsed_oid_list[i]);
      loop assigns i,
                   parsed_oid_list[0 ..
                                       sizeof(known_ext_oids) /
                                       sizeof(known_ext_oids[0]) - 1];
      loop variant sizeof(known_ext_oids) / sizeof(known_ext_oids[0]) - i;
      loop unroll sizeof(known_ext_oids) / sizeof(known_ext_oids[0]);
  */
  while ((unsigned long)i < sizeof(known_ext_oids) / sizeof(known_ext_oids[0])) {
    parsed_oid_list[i] = (_ext_oid const *)0;
    i = (u16)((int)i + 1);
  }
  /*@
  assert
  \initialized(&parsed_oid_list[0 ..
                                    sizeof(known_ext_oids) /
                                    sizeof(known_ext_oids[0]) - 1]);
   */
  ;
  /*@ loop invariant remain ≢ 0 ⇒ \valid_read(buf + (0 .. remain - 1));
      loop assigns ret, buf, remain,
                   parsed_oid_list[0 ..
                                       sizeof(known_ext_oids) /
                                       sizeof(known_ext_oids[0]) - 1],
                   *ctx;
      loop variant remain;
  */
  while (remain) {
    u16 ext_len = (unsigned short)0;
    ret = parse_x509_Extension(buf,remain,parsed_oid_list,& ext_len,ctx);
    if (ret) goto out;
    remain = (unsigned short)((int)remain - (int)ext_len);
    buf += (int)ext_len;
  }
  if (ctx->empty_subject) {
    if (ctx->san_empty) {
      ret = -8436;
      goto out;
    }
    if (! ctx->san_critical) {
      ret = -8441;
      goto out;
    }
  }
  /*@ assert 1 ≤ saved_len ≤ len; */ ;
  *eaten = saved_len;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(sig_alg, eaten, buf + (..));
    ensures \result ≤ 0;
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    ensures \result ≡ 0 ⇒ 1 < *\old(eaten) ≤ \old(len);
    assigns *eaten, *sig_alg;
 */
static int parse_x509_tbsCertificate(u8 const *buf, u16 len,
                                     _alg_id const **sig_alg, u16 *eaten)
{
  u8 const *subject_ptr;
  u8 const *issuer_ptr;
  u16 subject_len;
  u16 issuer_len;
  alg_param param;
  cert_parsing_ctx ctx;
  int ret;
  u16 tbs_data_len = (unsigned short)0;
  u16 tbs_hdr_len = (unsigned short)0;
  u16 remain = (unsigned short)0;
  u16 parsed = (unsigned short)0;
  _alg_id const *alg = (_alg_id const *)0;
  int empty_issuer = 1;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -8506;
              goto out;
            }
    }
  ctx.empty_subject = 0;
  ctx.san_empty = 0;
  ctx.san_critical = 0;
  ctx.ca_true = 0;
  ctx.bc_critical = 0;
  ctx.has_ski = 0;
  ctx.has_keyUsage = 0;
  ctx.keyCertSign_set = 0;
  ctx.cRLSign_set = 0;
  ctx.pathLenConstraint_set = 0;
  ctx.has_name_constraints = 0;
  ctx.has_crldp = 0;
  ctx.one_crldp_has_all_reasons = 0;
  ctx.aki_has_keyIdentifier = 0;
  ctx.self_signed = 0;
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_SEQUENCE,& tbs_hdr_len,
                     & tbs_data_len);
  if (ret) goto out;
  buf += (int)tbs_hdr_len;
  remain = tbs_data_len;
  ret = parse_x509_Version(buf,remain,& parsed);
  if (ret) goto out;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ret = parse_CertificateSerialNumber(buf,remain,CLASS_UNIVERSAL,
                                      (unsigned int)ASN1_TYPE_INTEGER,
                                      & parsed);
  if (ret) goto out;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ret = parse_x509_AlgorithmIdentifier(buf,remain,& alg,& param,& parsed);
  if (ret) goto out;
  if ((int)alg->alg_type != ALG_SIG) {
    ret = -8583;
    goto out;
  }
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ret = parse_x509_Name(buf,remain,& parsed,& empty_issuer);
  if (ret) goto out;
  /*@ assert empty_issuer ≡ 0 ∨ empty_issuer ≡ 1; */ ;
  if (empty_issuer) {
    ret = -8604;
    goto out;
  }
  issuer_ptr = buf;
  issuer_len = parsed;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ret = parse_x509_Validity(buf,remain,& parsed);
  if (ret) goto out;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ret = parse_x509_Name(buf,remain,& parsed,& ctx.empty_subject);
  if (ret) goto out;
  subject_ptr = buf;
  subject_len = parsed;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  ctx.self_signed = 0;
  if ((int)subject_len == (int)issuer_len) {
    int tmp_0;
    int tmp;
    tmp = bufs_differ(subject_ptr,issuer_ptr,issuer_len);
    if (tmp) tmp_0 = 0; else tmp_0 = 1;
    ctx.self_signed = tmp_0;
  }
  ret = parse_x509_subjectPublicKeyInfo(buf,remain,& parsed);
  if (ret) goto out;
  buf += (int)parsed;
  remain = (unsigned short)((int)remain - (int)parsed);
  if (remain) {
    ret = parse_x509_Extensions(buf,remain,& parsed,& ctx);
    if (ret) goto out;
    buf += (int)parsed;
    remain = (unsigned short)((int)remain - (int)parsed);
  }
  if ((int)remain != 0) {
    ret = -8698;
    goto out;
  }
  if (ctx.ca_true) 
    if (! ctx.has_ski) {
      ret = -8710;
      goto out;
    }
  if (ctx.keyCertSign_set) 
    if (! ctx.ca_true) goto _LOR_0;
    else 
      if (! ctx.bc_critical) {
        _LOR_0: {
                  ret = -8734;
                  goto out;
                }
      }
  if (ctx.cRLSign_set) 
    if (ctx.empty_subject) {
      ret = -8747;
      goto out;
    }
  if (ctx.pathLenConstraint_set) 
    if (! ctx.ca_true) goto _LOR_1;
    else 
      if (! ctx.keyCertSign_set) {
        _LOR_1: {
                  ret = -8759;
                  goto out;
                }
      }
  if (ctx.has_name_constraints) 
    if (! ctx.ca_true) {
      ret = -8769;
      goto out;
    }
  if (ctx.ca_true) 
    if (ctx.has_crldp) 
      if (! ctx.one_crldp_has_all_reasons) {
        ret = -8781;
        goto out;
      }
  if (! ctx.self_signed) 
    if (! ctx.aki_has_keyIdentifier) {
      ret = -8795;
      goto out;
    }
  /*@ assert 1 < tbs_hdr_len + tbs_data_len ≤ len; */ ;
  *eaten = (unsigned short)((int)tbs_hdr_len + (int)tbs_data_len);
  *sig_alg = alg;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..), exp_sig_alg);
    ensures \result ≤ 0;
    ensures \result ≡ 0 ⇒ 1 < *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_x509_signatureAlgorithm(u8 const *buf, u16 len,
                                         _alg_id const *exp_sig_alg,
                                         u16 *eaten)
{
  alg_param param;
  int ret;
  _alg_id const *alg = (_alg_id const *)0;
  u16 parsed = (unsigned short)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -8830;
              goto out;
            }
    }
  ret = parse_x509_AlgorithmIdentifier(buf,len,& alg,& param,& parsed);
  if (ret) goto out;
  if ((int)alg->alg_type != ALG_SIG) {
    ret = -8843;
    goto out;
  }
  buf += (int)parsed;
  len = (unsigned short)((int)len - (int)parsed);
  if (alg != exp_sig_alg) {
    ret = -8857;
    goto out;
  }
  *eaten = parsed;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..));
    ensures \result ≤ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_sig_generic(u8 const *buf, u16 len, u16 *eaten)
{
  int ret;
  u16 bs_hdr_len = (unsigned short)0;
  u16 bs_data_len = (unsigned short)0;
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_BIT_STRING,& bs_hdr_len,
                     & bs_data_len);
  if (ret) goto out;
  if ((int)bs_data_len == 0) {
    ret = -8901;
    goto out;
  }
  *eaten = (unsigned short)((int)bs_hdr_len + (int)bs_data_len);
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..));
    ensures \result ≤ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_sig_ecdsa(u8 const *buf, u16 len, u16 *eaten)
{
  int ret;
  u16 bs_hdr_len = (unsigned short)0;
  u16 bs_data_len = (unsigned short)0;
  u16 sig_len = (unsigned short)0;
  u16 hdr_len = (unsigned short)0;
  u16 data_len = (unsigned short)0;
  u16 remain = (unsigned short)0;
  u16 saved_sig_len = (unsigned short)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -8933;
              goto out;
            }
    }
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_BIT_STRING,& bs_hdr_len,
                     & bs_data_len);
  if (ret) goto out;
  saved_sig_len = (unsigned short)((int)bs_hdr_len + (int)bs_data_len);
  /*@ assert saved_sig_len ≤ len; */ ;
  buf += (int)bs_hdr_len;
  if ((int)bs_data_len == 0) {
    ret = -8955;
    goto out;
  }
  if ((int)*(buf + 0) != 0) {
    ret = -8984;
    goto out;
  }
  buf ++;
  sig_len = (unsigned short)((int)bs_data_len - 1);
  ret = parse_id_len(buf,sig_len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_SEQUENCE,& hdr_len,& data_len);
  if (ret) goto out;
  remain = (unsigned short)((int)sig_len - (int)hdr_len);
  buf += (int)hdr_len;
  ret = parse_id_len(buf,remain,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_INTEGER,& hdr_len,& data_len);
  if (ret) goto out;
  remain = (unsigned short)((int)remain - ((int)hdr_len + (int)data_len));
  buf += (int)hdr_len + (int)data_len;
  ret = parse_id_len(buf,remain,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_INTEGER,& hdr_len,& data_len);
  if (ret) goto out;
  remain = (unsigned short)((int)remain - ((int)hdr_len + (int)data_len));
  buf += (int)hdr_len + (int)data_len;
  if ((int)remain != 0) {
    ret = -9033;
    goto out;
  }
  /*@ assert saved_sig_len ≤ len; */ ;
  *eaten = saved_sig_len;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires
      sig_alg ≢ \null ⇒
      \valid_read(sig_alg) ∧ \valid_function(sig_alg->parse_sig);
    requires \valid(eaten);
    ensures \result ≤ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_x509_signatureValue(u8 const *buf, u16 len,
                                     _alg_id const *sig_alg, u16 *eaten)
{
  int ret;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -9065;
              goto out;
            }
    }
  if (! sig_alg) {
    ret = -9071;
    goto out;
  }
  if (! sig_alg->parse_sig) {
    ret = -9077;
    goto out;
  }
  /*@ calls parse_sig_ecdsa, parse_sig_generic; */
  ret = (*(sig_alg->parse_sig))(buf,len,eaten);
  if (ret) goto out;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    ensures \result ≤ 0;
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns \nothing;
 */
int parse_x509_cert(u8 const *buf, u16 len)
{
  int ret;
  u16 seq_data_len = (unsigned short)0;
  u16 eaten = (unsigned short)0;
  _alg_id const *sig_alg = (_alg_id const *)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -9110;
              goto out;
            }
    }
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_SEQUENCE,& eaten,& seq_data_len);
  if (ret) goto out;
  len = (unsigned short)((int)len - (int)eaten);
  buf += (int)eaten;
  if ((int)seq_data_len != (int)len) {
    ret = -9134;
    goto out;
  }
  ret = parse_x509_tbsCertificate(buf,len,& sig_alg,& eaten);
  if (ret) goto out;
  len = (unsigned short)((int)len - (int)eaten);
  buf += (int)eaten;
  ret = parse_x509_signatureAlgorithm(buf,len,sig_alg,& eaten);
  if (ret) goto out;
  len = (unsigned short)((int)len - (int)eaten);
  buf += (int)eaten;
  ret = parse_x509_signatureValue(buf,len,sig_alg,& eaten);
  if (ret) goto out;
  if ((int)len != (int)eaten) {
    ret = -9168;
    goto out;
  }
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \separated(eaten, buf + (..));
    requires \valid(eaten);
    ensures \result ≤ 1;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \result ≡ 0 ⇒ *\old(eaten) > 0;
    ensures \result < 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \result < 0 ⇒ *\old(eaten) > 0;
    assigns *eaten;
 */
int parse_x509_cert_relaxed(u8 const *buf, u16 len, u16 *eaten)
{
  int ret;
  u16 seq_data_len = (unsigned short)0;
  u16 rbytes = (unsigned short)0;
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_SEQUENCE,& rbytes,
                     & seq_data_len);
  if (ret) {
    ret = 1;
    goto out;
  }
  *eaten = (unsigned short)((int)rbytes + (int)seq_data_len);
  ret = parse_x509_cert(buf,
                        (unsigned short)((int)rbytes + (int)seq_data_len));
  if (ret) goto out;
  ret = 0;
  out: ;
  return ret;
}

int main(int argc, char **argv)
{
  u8 buf[65535];
  u16 len;
  int ret;
  int tmp;
  /*@ assert \valid(&buf[0 .. 65535 - 1]); */ ;
  Frama_C_make_unknown((char *)(buf),(unsigned long)65535);
  tmp = Frama_C_interval(0,65535);
  len = (unsigned short)tmp;
  /*@ assert 0 ≤ len ≤ 65535; */ ;
  ret = parse_x509_cert((u8 const *)(buf),len);
  return ret;
}



  ret = (*(cur->parse_rdn_val))(buf,data_len);
  if (ret) goto out;
  *eaten = parsed;
  /*@ assert *eaten ≤ \at(len,Pre); */ ;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;

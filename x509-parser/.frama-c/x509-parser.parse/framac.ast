                     (unsigned int)ASN1_TYPE_SEQUENCE,& hdr_len,& data_len);
  if (ret) goto out;
  parsed = (unsigned short)((int)hdr_len + (int)data_len);
  /*@ assert parsed ≤ len; */ ;
  buf += (int)hdr_len;

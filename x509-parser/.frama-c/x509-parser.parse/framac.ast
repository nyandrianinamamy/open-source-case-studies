  if (ret) goto out;
  buf += (int)ext_hdr_len;
  remain = (unsigned short)((int)remain - (int)ext_hdr_len);
  saved_ext_len = (unsigned short)((int)ext_hdr_len + (int)ext_data_len);
  /*@
  assert
  \initialized(parsed_oid_list +
               (0 .. sizeof(known_ext_oids) / sizeof(known_ext_oids[0]) - 1));
   */
  ;

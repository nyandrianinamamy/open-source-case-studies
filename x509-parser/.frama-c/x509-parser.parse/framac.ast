  u16 remain = (unsigned short)0;
  u16 ext_hdr_len = (unsigned short)0;
  u16 ext_data_len = (unsigned short)0;
  u16 oid_len = (unsigned short)0;
  u16 saved_ext_len = (unsigned short)0;

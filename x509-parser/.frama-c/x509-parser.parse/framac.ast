  while (remain) {
    u16 parsed = (unsigned short)0;
    ret = parse_RelativeDistinguishedName(buf,remain,& parsed);
    if (ret) goto out;
    buf += (int)parsed;
    remain = (unsigned short)((int)remain - (int)parsed);
  }
  *eaten = (unsigned short)((int)name_hdr_len + (int)name_data_len);
  *empty = ! name_data_len;
  /*@ assert *empty ≡ 0 ∨ *empty ≡ 1; */ ;
  ret = 0;
  out: ;
  return ret;
}

/*@ requires 0x30 ≤ d ≤ 0x39;
    requires 0x30 ≤ u ≤ 0x39;
    ensures 0 ≤ \result ≤ 99;
    assigns \nothing;
 */
u8 compute_decimal(u8 d, u8 u)
{
  u8 __retres;
  __retres = (unsigned char)(((int)d - 0x30) * 10 + ((int)u - 0x30));
  return __retres;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \valid(eaten);
    requires \valid(year);
    requires \valid(month);
    requires \valid(day);
    requires \valid(hour);
    requires \valid(min);
    requires \valid(sec);
    requires
      \separated(
        eaten, year, month, day, hour, min, sec, buf + (0 .. len - 1)
        );
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \result ≡ 0 ⇒ *\old(eaten) ≡ 15;
    ensures \old(len) < 15 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten, *year, *month, *day, *hour, *min, *sec;
 */
static int parse_UTCTime(u8 const *buf, u16 len, u16 *eaten, u16 *year,
                         u8 *month, u8 *day, u8 *hour, u8 *min, u8 *sec)
{
  u16 yyyy;
  u8 mo;
  u8 dd;
  u8 hh;
  u8 mm;
  u8 ss;
  u8 time_type;
  u16 time_len;
  u8 i;
  u8 tmp;
  u8 tmp_0;
  u8 const c_zero = (unsigned char)'0';
  int ret = -3858;
  if (buf == (u8 const *)0) {
    ret = -3862;
    goto out;
  }
  if ((int)len < 15) {
    ret = -3875;
    goto out;
  }
  time_type = *(buf + 0);
  if ((int)time_type != ASN1_TYPE_UTCTime) {
    ret = -3882;
    goto out;
  }
  time_len = (unsigned short)*(buf + 1);
  if ((int)time_len != (int)((unsigned char)13)) {
    ret = -3889;
    goto out;
  }
  buf += 2;
  i = (unsigned char)0;
  /*@ loop invariant \valid_read(buf + i);
      loop invariant ∀ ℤ x; 0 ≤ x < i ⇒ 0x30 ≤ *(buf + x) ≤ 0x39;
      loop assigns i;
      loop variant 12 - i;
      loop unroll 12;
  */
  while ((int)i < 12) {
    if ((int)c_zero > (int)*(buf + i)) {
      ret = -3908;
      goto out;
    }
    if ((int)*(buf + i) - (int)c_zero > 9) {
      ret = -3913;
      goto out;
    }
    /*@ assert 0 ≤ *(buf + i) - c_zero ≤ 9; */ ;
    i = (u8)((int)i + 1);
  }
  if ((int)*(buf + 12) != 'Z') {
    ret = -3920;
    goto out;
  }
  /*@ assert c_zero ≡ 0x30; */ ;
  /*@ assert ∀ ℤ x; 0 ≤ x < 12 ⇒ 0x30 ≤ *(buf + x) ≤ 0x39; */ ;
  tmp_0 = compute_decimal(*(buf + 0),*(buf + 1));
  yyyy = (unsigned short)tmp_0;
  if ((int)yyyy >= 50) yyyy = (unsigned short)((int)yyyy + 1900);
  else yyyy = (unsigned short)((int)yyyy + 2000);
  mo = compute_decimal(*(buf + 2),*(buf + 3));
  dd = compute_decimal(*(buf + 4),*(buf + 5));
  hh = compute_decimal(*(buf + 6),*(buf + 7));
  mm = compute_decimal(*(buf + 8),*(buf + 9));
  ss = compute_decimal(*(buf + 10),*(buf + 11));
  tmp = (unsigned char)0;
  tmp = (unsigned char)((int)tmp | ((int)mo > 12));
  tmp = (unsigned char)((int)tmp | ((int)dd > 31));
  tmp = (unsigned char)((int)tmp | ((int)hh > 23));
  tmp = (unsigned char)((int)tmp | ((int)mm > 59));
  tmp = (unsigned char)((int)tmp | ((int)ss > 59));
  if (tmp) {
    ret = -3952;
    goto out;
  }
  *year = yyyy;
  *month = mo;
  *day = dd;
  *hour = hh;
  *min = mm;
  *sec = ss;
  ret = 0;
  out: if (! ret) *eaten = (unsigned short)15;
  return ret;
}

/*@ requires 0x30 ≤ d1 ≤ 0x39;
    requires 0x30 ≤ d2 ≤ 0x39;
    requires 0x30 ≤ d3 ≤ 0x39;
    requires 0x30 ≤ d4 ≤ 0x39;
    ensures 0 ≤ \result ≤ 9999;
    assigns \nothing;
 */
u16 compute_year(u8 d1, u8 d2, u8 d3, u8 d4)
{
  u16 __retres;
  __retres = (unsigned short)(((((int)((unsigned short)d1) - (int)((unsigned short)0x30)) * 1000 + 
                                ((int)((unsigned short)d2) - (int)((unsigned short)0x30)) * 100) + 
                               ((int)((unsigned short)d3) - (int)((unsigned short)0x30)) * 10) + (
                              (int)((unsigned short)d4) - (int)((unsigned short)0x30)));
  return __retres;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \valid(year);
    requires \valid(month);
    requires \valid(day);
    requires \valid(hour);
    requires \valid(min);
    requires \valid(sec);
    requires
      \separated(
        eaten, year, month, day, hour, min, sec, buf + (0 .. len - 1)
        );
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \result ≡ 0 ⇒ *\old(eaten) ≡ 17;
    ensures \old(len) < 17 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten, *year, *month, *day, *hour, *min, *sec;
 */
static int parse_generalizedTime(u8 const *buf, u16 len, u16 *eaten,
                                 u16 *year, u8 *month, u8 *day, u8 *hour,
                                 u8 *min, u8 *sec)
{
  u16 yyyy;
  u8 mo;
  u8 dd;
  u8 hh;
  u8 mm;
  u8 ss;
  u8 time_type;
  u16 time_len;
  u8 i;
  u8 tmp;
  u8 const c_zero = (unsigned char)'0';
  int ret = -4024;
  if (buf == (u8 const *)0) {
    ret = -4028;
    goto out;
  }
  if ((int)len < 17) {
    ret = -4041;
    goto out;
  }
  time_type = *(buf + 0);
  if ((int)time_type != ASN1_TYPE_GeneralizedTime) {
    ret = -4048;
    goto out;
  }
  time_len = (unsigned short)*(buf + 1);
  if ((int)time_len != 15) {
    ret = -4055;
    goto out;
  }
  buf += 2;
  i = (unsigned char)0;
  /*@ loop invariant \valid_read(buf + i);
      loop invariant ∀ ℤ x; 0 ≤ x < i ⇒ 0x30 ≤ *(buf + x) ≤ 0x39;
      loop assigns i;
      loop variant 14 - i;
  */
  while ((int)i < 14) {
    if ((int)c_zero > (int)*(buf + i)) {
      ret = -4074;
      goto out;
    }
    if ((int)*(buf + i) - (int)c_zero > 9) {
      ret = -4079;
      goto out;
    }
    i = (u8)((int)i + 1);
  }
  if ((int)*(buf + 14) != 'Z') {
    ret = -4085;
    goto out;
  }
  /*@ assert c_zero ≡ 0x30; */ ;
  /*@ assert ∀ ℤ x; 0 ≤ x < 12 ⇒ 0x30 ≤ *(buf + x) ≤ 0x39; */ ;
  yyyy = compute_year(*(buf + 0),*(buf + 1),*(buf + 2),*(buf + 3));
  mo = compute_decimal(*(buf + 4),*(buf + 5));
  dd = compute_decimal(*(buf + 6),*(buf + 7));
  hh = compute_decimal(*(buf + 8),*(buf + 9));
  mm = compute_decimal(*(buf + 10),*(buf + 11));
  ss = compute_decimal(*(buf + 12),*(buf + 13));
  tmp = (unsigned char)0;
  tmp = (unsigned char)((int)tmp | ((int)yyyy <= 2049));
  tmp = (unsigned char)((int)tmp | ((int)mo > 12));
  tmp = (unsigned char)((int)tmp | ((int)dd > 31));
  tmp = (unsigned char)((int)tmp | ((int)hh > 23));
  tmp = (unsigned char)((int)tmp | ((int)mm > 59));
  tmp = (unsigned char)((int)tmp | ((int)ss > 59));
  if (tmp) {
    ret = -4112;
    goto out;
  }
  *year = yyyy;
  *month = mo;
  *day = dd;
  *hour = hh;
  *min = mm;
  *sec = ss;
  ret = 0;
  out: if (! ret) *eaten = (unsigned short)17;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \valid(eaten);
    requires \valid(year);
    requires \valid(month);
    requires \valid(day);
    requires \valid(hour);
    requires \valid(min);
    requires \valid(sec);
    requires
      \separated(t_type, eaten, year, month, day, hour, min, sec, buf + (..));
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *t_type, *eaten, *year, *month, *day, *hour, *min, *sec;
 */
static int parse_Time(u8 const *buf, u16 len, u8 *t_type, u16 *eaten,
                      u16 *year, u8 *month, u8 *day, u8 *hour, u8 *min,
                      u8 *sec)
{
  u8 time_type;
  int ret = -4164;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -4167;
              goto out;
            }
    }
  if ((int)len < 2) {
    ret = -4173;
    goto out;
  }
  time_type = *(buf + 0);
  switch ((int)time_type) {
    case ASN1_TYPE_UTCTime:
    ret = parse_UTCTime(buf,len,eaten,year,month,day,hour,min,sec);
    if (ret) ;
    break;
    case ASN1_TYPE_GeneralizedTime:
    ret = parse_generalizedTime(buf,len,eaten,year,month,day,hour,min,sec);
    if (ret) ;
    break;
    default: ret = -4195;
    break;
  }
  *t_type = time_type;
  out: ;
  if (ret) *eaten = (unsigned short)0;
  return ret;
}

/*@ ensures \result < 0 ∨ \result ≡ 0;
    assigns \nothing; */
static int _verify_correct_time_use(u8 time_type, u16 yyyy)
{
  int ret;
  switch ((int)time_type) {
    case ASN1_TYPE_UTCTime: if ((int)yyyy <= 2049) ret = 0; else ret = -4226;
    break;
    case ASN1_TYPE_GeneralizedTime:
    if ((int)yyyy >= 2050) ret = 0; else ret = -4229;
    break;
    default: ret = -1;
    break;
  }
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..));
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
    assigns *eaten;
 */
static int parse_x509_Validity(u8 const *buf, u16 len, u16 *eaten)
{
  int ret;
  u16 hdr_len = (unsigned short)0;
  u16 remain = (unsigned short)0;
  u16 data_len = (unsigned short)0;
  u16 nb_len = (unsigned short)0;
  u16 na_len = (unsigned short)0;
  u16 na_year = (unsigned short)0;
  u16 nb_year = (unsigned short)0;
  u8 na_month = (unsigned char)0;
  u8 na_day = (unsigned char)0;
  u8 na_hour = (unsigned char)0;
  u8 na_min = (unsigned char)0;
  u8 na_sec = (unsigned char)0;
  u8 nb_month = (unsigned char)0;
  u8 nb_day = (unsigned char)0;
  u8 nb_hour = (unsigned char)0;
  u8 nb_min = (unsigned char)0;
  u8 nb_sec = (unsigned char)0;
  u8 t_type = (unsigned char)0;
  if (buf == (u8 const *)0) goto _LOR;
  else 
    if ((int)len == 0) {
      _LOR: {
              ret = -4270;
              goto out;
            }
    }
  ret = parse_id_len(buf,len,CLASS_UNIVERSAL,
                     (unsigned int)ASN1_TYPE_SEQUENCE,& hdr_len,& data_len);
  if (ret) goto out;
  buf += (int)hdr_len;
  remain = data_len;
  ret = parse_Time(buf,remain,& t_type,& nb_len,& nb_year,& nb_month,
                   & nb_day,& nb_hour,& nb_min,& nb_sec);
  if (ret) goto out;
  ret = _verify_correct_time_use(t_type,nb_year);
  if (ret) goto out;
  remain = (unsigned short)((int)remain - (int)nb_len);
  buf += (int)nb_len;
  ret = parse_Time(buf,remain,& t_type,& na_len,& na_year,& na_month,
                   & na_day,& na_hour,& na_min,& na_sec);
  if (ret) goto out;
  ret = _verify_correct_time_use(t_type,na_year);
  if (ret) goto out;
  remain = (unsigned short)((int)remain - (int)na_len);
  if (remain) {
    ret = -4321;
    goto out;
  }
  if ((int)na_year < (int)nb_year) {
    ret = -4328;
    goto out;
  }
  else 
    if ((int)na_year == (int)nb_year) {
      u32 na_rem_secs;
      u32 nb_rem_secs;
      na_rem_secs = (unsigned int)0;
      na_rem_secs += (u32)((int)na_month * (31 * (24 * (60 * 60))));
      na_rem_secs += (u32)((int)na_day * (24 * (60 * 60)));
      na_rem_secs += (u32)((int)na_hour * (60 * 60));
      na_rem_secs += (u32)((int)na_min * 60);
      na_rem_secs += (u32)na_sec;
      nb_rem_secs = (unsigned int)0;
      nb_rem_secs += (u32)((int)nb_month * (31 * (24 * (60 * 60))));
      nb_rem_secs += (u32)((int)nb_day * (24 * (60 * 60)));
      nb_rem_secs += (u32)((int)nb_hour * (60 * 60));
      nb_rem_secs += (u32)((int)nb_min * 60);
      nb_rem_secs += (u32)nb_sec;
      if (na_rem_secs <= nb_rem_secs) {
        ret = -4354;
        goto out;
      }
    }
  *eaten = (unsigned short)((int)hdr_len + (int)data_len);
  ret = 0;
  out: ;
  return ret;
}

/*@ requires len ≥ 0;
    requires len > 0 ∧ buf ≢ \null ⇒ \valid_read(buf + (0 .. len - 1));
    requires \valid(eaten);
    requires \separated(eaten, buf + (..));
    ensures \result < 0 ∨ \result ≡ 0;
    ensures \result ≡ 0 ⇒ *\old(eaten) ≤ \old(len);
    ensures \old(len) ≡ 0 ⇒ \result < 0;
    ensures \old(buf) ≡ \null ⇒ \result < 0;
